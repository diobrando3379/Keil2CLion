#!/bin/sh
exec perl -x "$0" "$@"
#!/usr/bin/perl
# Keil2CLion for macOS: generate an arm-none-eabi-gcc CMake project next to a Keil5 project. Keil files are never touched.
# Usage: sh Keil2CLion.command <project folder>...   With no folder, converts the current folder or every project next to this file.
# Keep the generated files identical to what Keil2CLion.bat writes.
use strict;
use warnings;
use Cwd qw(abs_path getcwd);
use Encode ();
use File::Basename qw(basename dirname);
use File::Find qw(find);
use File::Path qw(make_path remove_tree);

my $Marker = 'Generated by Keil2CLion';

sub read_file {
    my ($path) = @_;
    open(my $fh, '<:raw', $path) or die "读不了文件: $path\n";
    local $/;
    my $text = <$fh>;
    close($fh);
    return defined $text ? $text : '';
}

sub write_file {
    my ($path, $text) = @_;
    open(my $fh, '>:raw', $path) or die "写不了文件: $path\n";
    print $fh $text;
    close($fh);
}

sub fill {
    my ($text, %map) = @_;
    for my $key (keys %map) {
        my $value = $map{$key};
        $text =~ s/\Q{$key}\E/$value/g;
    }
    return $text;
}

# <a><b>text</b></a> lookups; uvprojx has no attributes or same-name nesting on the tags used here
sub block {
    my ($text, $tag) = @_;
    return undef unless defined $text;
    return $text =~ m{<\Q$tag\E>(.*?)</\Q$tag\E>}s ? $1 : undef;
}

sub blocks {
    my ($text, $tag) = @_;
    return () unless defined $text;
    return $text =~ m{<\Q$tag\E>(.*?)</\Q$tag\E>}sg;
}

sub opt {
    my ($node, $path) = @_;
    for my $tag (split m{/}, $path) {
        $node = block($node, $tag);
        return '' unless defined $node;
    }
    $node =~ s/^\s+|\s+$//g;
    $node =~ s/&lt;/</g;
    $node =~ s/&gt;/>/g;
    $node =~ s/&quot;/"/g;
    $node =~ s/&apos;/'/g;
    $node =~ s/&amp;/&/g;
    return $node;
}

sub split_semi {
    my ($text) = @_;
    return grep { length } map { s/^\s+|\s+$//gr } split /[;,]/, $text;
}

sub rel_path {
    my ($path) = @_;
    $path =~ s{\\}{/}g;
    $path =~ s{^(\./)+}{};
    return $path;
}

sub uvprojx_files {
    my ($dir) = @_;
    opendir(my $dh, $dir) or return ();
    my @files = sort grep { /\.uvprojx$/i && -f "$dir/$_" } readdir($dh);
    closedir($dh);
    return @files;
}

# Files this script generated for an earlier version of itself or for a project that no longer needs them
sub remove_stale {
    my ($path) = @_;
    unlink($path) if -f $path && index(read_file($path), $Marker) >= 0;
}

# A build folder keeps the compiler and source path it was configured with, so one copied from
# another computer or configured with Keil's compiler has to be recreated
sub remove_stale_builds {
    my ($dir) = @_;
    my $here = lc(abs_path($dir));
    for my $build (glob("\Q$dir\E/cmake-build-*")) {
        next unless -d $build;
        my $stale = 0;
        my $cache = "$build/CMakeCache.txt";
        if (-f $cache && read_file($cache) =~ /^CMAKE_HOME_DIRECTORY:INTERNAL=(.*?)\r?$/m) {
            $stale = 1 if lc($1) ne $here;
        }
        for my $info (glob("\Q$build\E/CMakeFiles/*/CMakeCCompiler.cmake")) {
            $stale = 1 if read_file($info) =~ /armcc/i;
        }
        if ($stale) {
            remove_tree($build);
            print "  已删除过期的 " . basename($build) . "，CLion 会重新生成\n";
        }
    }
}

# Same Keil leftovers as the project's cleanup script; Keil regenerates all of them
sub remove_keil_files {
    my ($dir) = @_;
    my $removed = 0;
    for my $name ('DebugConfig', 'Listings', 'Objects') {
        if (-d "$dir/$name") { remove_tree("$dir/$name"); $removed++; }
    }
    for my $f (glob("\Q$dir\E/*.scvd"), glob("\Q$dir\E/*.uvguix.*")) {
        if (-f $f) { unlink($f); $removed++; }
    }
    find({ no_chdir => 1, wanted => sub {
        if (-f $_ && basename($_) =~ /\.DS_Store/) { unlink($_); $removed++; }
    } }, $dir);
    print "  已清理 Keil 中间文件，回到 Keil 后第一次会全部重新编译\n" if $removed;
}

# Keil startup file -> GNU assembler startup file, keeping its vector table and stack/heap sizes
sub convert_startup {
    my ($path) = @_;
    my @lines = map { (split /;/, $_, 2)[0] // '' } split /\r\n|\n|\r/, read_file($path);
    my $text = join("\n", @lines);
    $text =~ /^Stack_Size\s+EQU\s+(0x[0-9A-Fa-f]+|\d+)/mi or die "启动文件里找不到 Stack_Size: $path\n";
    my $stack = $1;
    $text =~ /^Heap_Size\s+EQU\s+(0x[0-9A-Fa-f]+|\d+)/mi or die "启动文件里找不到 Heap_Size: $path\n";
    my $heap = $1;

    my @vectors;
    my $in_table = 0;
    for my $line (@lines) {
        $in_table = 1 if $line =~ /^__Vectors\s+DCD/i;
        last if $line =~ /^__Vectors_End/i;
        push @vectors, $1 if $in_table && $line =~ /\bDCD\s+(\w+)/i;
    }
    if (@vectors < 16 || $vectors[0] ne '__initial_sp' || $vectors[1] ne 'Reset_Handler') {
        die "启动文件的向量表格式不认识: $path\n";
    }

    my (@table, @weak);
    for my $v (@vectors) {
        if ($v eq '__initial_sp') { push @table, '    .word _estack'; next; }
        if ($v eq '0') { push @table, '    .word 0'; next; }
        push @table, "    .word $v";
        push @weak, "    .weak $v\n    .thumb_set $v, Default_Handler" if $v ne 'Reset_Handler';
    }

    my $s = <<'END';
@ {MARKER} from {SOURCE}. Do not edit by hand.
    .syntax unified
    .cpu {CPU}
    .thumb

    .section .isr_vector, "a", %progbits
    .type g_pfnVectors, %object
g_pfnVectors:
{TABLE}
    .size g_pfnVectors, . - g_pfnVectors

    .section .text.Reset_Handler, "ax", %progbits
    .weak Reset_Handler
    .type Reset_Handler, %function
Reset_Handler:
    ldr r0, =_sdata
    ldr r1, =_edata
    ldr r2, =_sidata
1:  cmp r0, r1
    ittt lo
    ldrlo r3, [r2], #4
    strlo r3, [r0], #4
    blo 1b
    ldr r0, =_sbss
    ldr r1, =_ebss
    movs r2, #0
2:  cmp r0, r1
    itt lo
    strlo r2, [r0], #4
    blo 2b
    bl SystemInit
    bl __libc_init_array
    bl main
3:  b 3b
    .size Reset_Handler, . - Reset_Handler

    .section .text.Default_Handler, "ax", %progbits
    .type Default_Handler, %function
Default_Handler:
    b .
    .size Default_Handler, . - Default_Handler

{WEAK}
END
    $s = fill($s, SOURCE => basename($path), TABLE => join("\n", @table), WEAK => join("\n", @weak));
    return ($s, $stack, $heap);
}

sub convert_project {
    my ($dir) = @_;
    my @uv = uvprojx_files($dir);
    print "  注意: 有多个 .uvprojx，使用 $uv[0]\n" if @uv > 1;

    my $out_file = "$dir/CMakeLists.txt";
    if (-f $out_file && index(read_file($out_file), $Marker) < 0) {
        die "CMakeLists.txt 已存在且不是本脚本生成的，未覆盖。\n";
    }

    my $xml = read_file("$dir/$uv[0]");
    if ($xml =~ /^.*?encoding="([^"]+)"/ && lc($1) ne 'utf-8') {
        my $encoding = $1;
        eval { Encode::from_to($xml, $encoding, 'utf-8'); 1 } or die "不认识工程文件的编码: $encoding\n";
    }
    my @targets = blocks(block($xml, 'Targets'), 'Target');
    die "工程里没有 Target。\n" unless @targets;
    print "  注意: 有多个 Target，使用第一个\n" if @targets > 1;
    my $t = $targets[0];

    # Sources, in Keil's order
    my (@c_src, @asm_src);
    for my $group (blocks(block($t, 'Groups'), 'Group')) {
        next if opt($group, 'GroupOption/CommonProperty/IncludeInBuild') eq '0';
        for my $f (blocks(block($group, 'Files'), 'File')) {
            next if opt($f, 'FileOption/CommonProperty/IncludeInBuild') eq '0';
            my $rel = rel_path(opt($f, 'FilePath'));
            my $type = opt($f, 'FileType');
            next unless $type =~ /^[12348]$/;
            die "不支持 C++ 源文件: $rel\n" if $type eq '8';
            die "Keil 编译好的库或目标文件不能给 GCC 用: $rel\n" if $type eq '3' || $type eq '4';
            die "工程里列出的文件不存在: $rel\n" unless -e "$dir/$rel";
            if ($type eq '1') { push @c_src, $rel; } else { push @asm_src, $rel; }
        }
    }
    die "工程里应当正好有 1 个启动文件（.s），实际 " . scalar(@asm_src) . " 个。\n" if @asm_src != 1;

    # CPU
    my $cpu_str = opt($t, 'TargetOption/TargetCommonOption/Cpu');
    $cpu_str =~ /CPUTYPE\("([^"]+)"\)/i or die "读不出 CPU 型号: $cpu_str\n";
    my $cpu = lc($1);
    my $arch = "-mcpu=$cpu -mthumb";
    $arch .= ' -mfpu=fpv4-sp-d16 -mfloat-abi=hard' if $cpu_str =~ /FPU2/i;

    # Memory layout from Options for Target > Target
    my $ads = 'TargetOption/TargetArmAds';
    my $mem = "$ads/ArmAdsMisc/OnChipMemories";
    my $rom_base = opt($t, "$mem/OCR_RVCT4/StartAddress"); my $rom_size = opt($t, "$mem/OCR_RVCT4/Size");
    my $ram_base = opt($t, "$mem/OCR_RVCT9/StartAddress"); my $ram_size = opt($t, "$mem/OCR_RVCT9/Size");
    if (opt($t, "$ads/LDads/umfTarg") eq '0' && opt($t, "$ads/LDads/ScatterFile") ne '') {
        print "  注意: 工程用了自定义 .sct，GCC 用不了，已按 Target 页的内存布局生成链接脚本\n";
    }

    # C options
    my @c_opt = ('-g', '-ffunction-sections', '-fdata-sections');
    my %levels = (1 => '-O0', 2 => '-O1', 3 => '-O2', 4 => '-O3');
    push @c_opt, $levels{opt($t, "$ads/Cads/Optim")} // '-O2';
    push @c_opt, opt($t, "$ads/Cads/uC99") eq '1' ? '-std=gnu99' : '-std=gnu90';
    push @c_opt, '-fshort-enums' if opt($t, "$ads/Cads/EnumInt") eq '0';
    push @c_opt, opt($t, "$ads/Cads/PlainCh") eq '1' ? '-fsigned-char' : '-funsigned-char';
    my $w_level = opt($t, "$ads/Cads/wLevel");
    push @c_opt, '-w' if $w_level eq '1';
    push @c_opt, '-Wall' if $w_level eq '2';
    print "  注意: C/C++ 页的 Misc Controls 是 ARMCC 选项，已忽略\n" if opt($t, "$ads/Cads/VariousControls/MiscControls") ne '';

    # Defines: Keil adds the density macro itself, it is not in the project's Define box
    my $startup_path = "$dir/$asm_src[0]";
    my @defs = split_semi(opt($t, "$ads/Cads/VariousControls/Define"));
    push @defs, 'STM32F10X_' . uc($1) if basename($startup_path) =~ /^startup_stm32f10x_(\w+)\.s$/i;
    my %seen;
    @defs = grep { !$seen{$_}++ } @defs;
    my @incs = map { '${CMAKE_CURRENT_SOURCE_DIR}/' . rel_path($_) } split_semi(opt($t, "$ads/Cads/VariousControls/IncludePath"));

    my $name = opt($t, 'TargetOption/TargetCommonOption/OutputName');
    $name = $uv[0] =~ s/\.[^.]*$//r if $name eq '';
    my $target = $name =~ s/[^A-Za-z0-9_]/_/gr;

    # What the application needs from the C library, which Keil's MicroLIB gave it implicitly
    my $code = join("\n", map { read_file("$dir/$_") } grep { !m{^(Library|Start)/}i } @c_src);
    $code =~ s{/\*.*?\*/|//[^\n]*}{}sg;
    my $has_fputc = $code =~ /\bint\s+fputc\s*\(/i;
    my @link_opt = ('-Wl,--gc-sections', '-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/' . $name . '.map', '-T${CMAKE_CURRENT_SOURCE_DIR}/cmake/Project.ld');
    if ($code =~ /%[-+ #0]*\d*(\.\d+)?l?[fFeEgG]/) {
        push @link_opt, '-u _printf_float';
        push @link_opt, '-u _scanf_float' if $code =~ /\bscanf\s*\(/i;
    }

    my $cmake_dir = "$dir/cmake";
    make_path($cmake_dir);
    remove_stale("$cmake_dir/armcc-toolchain.cmake");
    remove_stale("$cmake_dir/Project.sct");
    remove_stale_builds($dir);
    remove_keil_files($dir);

    # Startup file
    my ($startup, $stack, $heap) = convert_startup($startup_path);
    write_file("$cmake_dir/startup_gcc.s", fill($startup, MARKER => $Marker, CPU => $cpu));
    my @src_list = ('cmake/startup_gcc.s');

    # core_cm3.c: its STREX inline assembly lets GCC use the same register twice, which the assembler rejects
    for my $c (@c_src) {
        if (lc(basename($c)) eq 'core_cm3.c') {
            my $core = read_file("$dir/$c");
            $core =~ s/(strex[bh]?\s+%0[^\n]*?)"=r"/$1"=&r"/g;
            write_file("$cmake_dir/core_cm3_gcc.c", "/* $Marker from $c */\n" . $core);
            push @src_list, 'cmake/core_cm3_gcc.c';
        } else {
            push @src_list, $c;
        }
    }

    # printf: Keil's MicroLIB calls fputc, GCC's newlib calls _write and buffers stdout
    my $compat_file = "$cmake_dir/keil_compat.c";
    if ($has_fputc) {
        my $compat = <<'END';
/* {MARKER}. Routes printf to the project's own fputc, as Keil's MicroLIB does. */
#include <stdio.h>

int _write(int fd, char *buf, int len)
{
    int i;
    (void)fd;
    for (i = 0; i < len; i++) {
        fputc((unsigned char)buf[i], stdout);
    }
    return len;
}

__attribute__((constructor)) static void keil_compat_stdio_init(void)
{
    setvbuf(stdout, NULL, _IONBF, 0);
}
END
        write_file($compat_file, fill($compat, MARKER => $Marker));
        push @src_list, 'cmake/keil_compat.c';
    } else {
        remove_stale($compat_file);
    }

    # Linker script
    my $ld = <<'END';
/* {MARKER}. Memory layout from the Keil project's Target page; stack and heap sizes from its startup file. */
ENTRY(Reset_Handler)

_estack = ORIGIN(RAM) + LENGTH(RAM);
_Min_Stack_Size = {STACK};
_Min_Heap_Size = {HEAP};

MEMORY
{
    FLASH (rx)  : ORIGIN = {ROMBASE}, LENGTH = {ROMSIZE}
    RAM   (xrw) : ORIGIN = {RAMBASE}, LENGTH = {RAMSIZE}
}

SECTIONS
{
    .isr_vector :
    {
        . = ALIGN(4);
        KEEP(*(.isr_vector))
        . = ALIGN(4);
    } >FLASH

    .text :
    {
        . = ALIGN(4);
        *(.text)
        *(.text*)
        *(.glue_7)
        *(.glue_7t)
        *(.eh_frame)
        KEEP(*(.init))
        KEEP(*(.fini))
        . = ALIGN(4);
        _etext = .;
    } >FLASH

    .rodata :
    {
        . = ALIGN(4);
        *(.rodata)
        *(.rodata*)
        . = ALIGN(4);
    } >FLASH

    .ARM.extab : { *(.ARM.extab* .gnu.linkonce.armextab.*) } >FLASH
    .ARM :
    {
        __exidx_start = .;
        *(.ARM.exidx*)
        __exidx_end = .;
    } >FLASH

    .preinit_array :
    {
        PROVIDE_HIDDEN(__preinit_array_start = .);
        KEEP(*(.preinit_array*))
        PROVIDE_HIDDEN(__preinit_array_end = .);
    } >FLASH
    .init_array :
    {
        PROVIDE_HIDDEN(__init_array_start = .);
        KEEP(*(SORT(.init_array.*)))
        KEEP(*(.init_array*))
        PROVIDE_HIDDEN(__init_array_end = .);
    } >FLASH
    .fini_array :
    {
        PROVIDE_HIDDEN(__fini_array_start = .);
        KEEP(*(SORT(.fini_array.*)))
        KEEP(*(.fini_array*))
        PROVIDE_HIDDEN(__fini_array_end = .);
    } >FLASH

    _sidata = LOADADDR(.data);

    .data :
    {
        . = ALIGN(4);
        _sdata = .;
        *(.data)
        *(.data*)
        . = ALIGN(4);
        _edata = .;
    } >RAM AT> FLASH

    .bss :
    {
        . = ALIGN(4);
        _sbss = .;
        __bss_start__ = _sbss;
        *(.bss)
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = .;
        __bss_end__ = _ebss;
    } >RAM

    ._user_heap_stack (NOLOAD) :
    {
        . = ALIGN(8);
        PROVIDE(end = .);
        PROVIDE(_end = .);
        . = . + _Min_Heap_Size;
        . = . + _Min_Stack_Size;
        . = ALIGN(8);
    } >RAM

    .ARM.attributes 0 : { *(.ARM.attributes) }
}
END
    write_file("$cmake_dir/Project.ld", fill($ld, MARKER => $Marker, ROMBASE => $rom_base, ROMSIZE => $rom_size, RAMBASE => $ram_base, RAMSIZE => $ram_size, STACK => $stack, HEAP => $heap));

    # Toolchain: no absolute paths from this machine, so the folder also builds on macOS and Linux
    my $toolchain = <<'END';
# {MARKER}. Do not edit by hand.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# IDEs started from the desktop often lack the shell's PATH, so look in the usual install folders too
file(GLOB ARM_GCC_HINTS
    "$ENV{ARM_GCC_ROOT}/bin"
    "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/*/bin"
    "C:/Program Files/Arm GNU Toolchain arm-none-eabi/*/bin"
    "/Applications/ArmGNUToolchain/*/arm-none-eabi/bin"
    "/opt/homebrew/bin"
    "/usr/local/bin"
)
find_program(ARM_GCC arm-none-eabi-gcc HINTS ${ARM_GCC_HINTS})
if(NOT ARM_GCC)
    message(FATAL_ERROR "arm-none-eabi-gcc not found. Install the Arm GNU Toolchain or set the ARM_GCC_ROOT environment variable.")
endif()
get_filename_component(ARM_GCC_BIN "${ARM_GCC}" DIRECTORY)

set(CMAKE_C_COMPILER "${ARM_GCC}")
set(CMAKE_ASM_COMPILER "${ARM_GCC}")
find_program(ARM_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_GCC_BIN}")
find_program(ARM_SIZE arm-none-eabi-size HINTS "${ARM_GCC_BIN}")

set(CMAKE_C_FLAGS_INIT "{ARCH}")
set(CMAKE_ASM_FLAGS_INIT "{ARCH}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "{ARCH} --specs=nano.specs --specs=nosys.specs")
END
    write_file("$cmake_dir/arm-none-eabi-toolchain.cmake", fill($toolchain, MARKER => $Marker, ARCH => $arch));

    my $fmt = sub {
        return join("\n", map {
            /^-u / ? qq{    "SHELL:$_"} : /\s/ ? qq{    "$_"} : "    $_"
        } @_);
    };
    my $fmt_c = sub {
        return join("\n", map {
            /\s/ ? qq{    "\$<\$<COMPILE_LANGUAGE:C>:$_>"} : "    \$<\$<COMPILE_LANGUAGE:C>:$_>"
        } @_);
    };

    my $cmake = <<'END';
# {MARKER} from {UVPROJX}. Re-run it after adding files in Keil; do not edit by hand.
cmake_minimum_required(VERSION 3.20)

if(NOT CMAKE_TOOLCHAIN_FILE)
    set(CMAKE_TOOLCHAIN_FILE "${CMAKE_CURRENT_SOURCE_DIR}/cmake/arm-none-eabi-toolchain.cmake")
endif()

project({TARGET} LANGUAGES C ASM)

# Build settings come from the Keil project, whichever CLion profile is selected
foreach(cfg DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set(CMAKE_C_FLAGS_${cfg} "")
    set(CMAKE_ASM_FLAGS_${cfg} "")
    set(CMAKE_EXE_LINKER_FLAGS_${cfg} "")
endforeach()

add_executable({TARGET}
{SRC}
)
set_target_properties({TARGET} PROPERTIES OUTPUT_NAME "{NAME}" SUFFIX ".elf")

target_include_directories({TARGET} PRIVATE
{INCS}
)
target_compile_definitions({TARGET} PRIVATE
{DEFS}
)
target_compile_options({TARGET} PRIVATE
{COPT}
)
target_link_options({TARGET} PRIVATE
{LOPT}
)
set_target_properties({TARGET} PROPERTIES LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/cmake/Project.ld")

add_custom_command(TARGET {TARGET} POST_BUILD
    COMMAND "${ARM_OBJCOPY}" -O ihex "$<TARGET_FILE_NAME:{TARGET}>" "{NAME}.hex"
    COMMAND "${ARM_SIZE}" "$<TARGET_FILE_NAME:{TARGET}>"
    COMMENT "Creating {NAME}.hex"
)
END
    write_file($out_file, fill($cmake,
        MARKER => $Marker, UVPROJX => $uv[0], TARGET => $target, NAME => $name,
        SRC => $fmt->(@src_list), INCS => $fmt_c->(@incs), DEFS => $fmt_c->(@defs), COPT => $fmt_c->(@c_opt), LOPT => $fmt->(@link_opt)));

    print "  完成: " . scalar(@c_src) . " 个 C 文件, CPU $cpu, 宏 @defs\n";
}

# Double-clicking a .command starts in the home folder, so fall back to this file's own folder
my @roots = @ARGV;
if (!@roots) {
    @roots = uvprojx_files(getcwd()) ? (getcwd()) : (dirname(abs_path($0)));
}

my @projects;
for my $root (@roots) {
    $root =~ s{/+$}{} if length($root) > 1;
    if (!-d $root) {
        print "失败: 不是文件夹: $root\n";
        exit 1;
    }
    if (uvprojx_files($root)) {
        push @projects, abs_path($root);
    } else {
        opendir(my $dh, $root) or die "打不开文件夹: $root\n";
        push @projects, map { abs_path("$root/$_") } sort grep { !/^\./ && -d "$root/$_" && uvprojx_files("$root/$_") } readdir($dh);
        closedir($dh);
    }
}
if (!@projects) {
    print "失败: @roots 及其子文件夹里没有 .uvprojx 工程。\n";
    exit 1;
}

my $failed = 0;
for my $p (@projects) {
    print "\n$p\n";
    eval { convert_project($p); 1 } or do { print "  失败: $@"; $failed++; };
}
exit 1 if $failed;
print "\n用 CLion 打开工程文件夹即可编译，输出在 cmake-build-debug 里。\n";
exit 0;
