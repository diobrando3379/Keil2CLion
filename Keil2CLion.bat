@echo off
rem Keil2CLion: generate an arm-none-eabi-gcc CMake project next to a Keil5 project. Keil files are never touched.
rem Usage: drag a project folder onto this file, or double-click to convert every project next to it.
chcp 65001 >nul
setlocal
set "K2C_BAT=%~f0"
set "K2C_ARG=%~1"
powershell -NoProfile -Command "$s=[IO.File]::ReadAllText($env:K2C_BAT,[Text.Encoding]::UTF8); Invoke-Expression $s.Substring($s.IndexOf('#'+'__PS__'))"
set "K2C_RC=%errorlevel%"
if not defined K2C_NOPAUSE pause
exit /b %K2C_RC%

#__PS__
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
# Keep the generated files identical to what Keil2CLion.command writes
$Marker = 'Generated by Keil2CLion'
$Latin1 = [Text.Encoding]::GetEncoding(28591)

function Get-Opt($node, $path) {
    $n = $node.SelectSingleNode($path)
    if ($n) { return $n.InnerText.Trim() }
    return ''
}

function Split-Semi($text) {
    return @($text -split '[;,]' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
}

function Get-RelPath($path) {
    return (($path -replace '\\', '/') -replace '^(\./)+', '')
}

function Save-Text($path, $text) {
    [IO.File]::WriteAllText($path, (($text -replace "`r`n", "`n") + "`n"), (New-Object Text.UTF8Encoding($false)))
}

# Files this script generated for an earlier version of itself or for a project that no longer needs them
function Remove-Stale($path) {
    if ((Test-Path -LiteralPath $path) -and ([IO.File]::ReadAllText($path)).Contains($Marker)) {
        Remove-Item -LiteralPath $path -Force
    }
}

# A build folder keeps the compiler and source path it was configured with, so one copied from
# another computer or configured with Keil's compiler has to be recreated
function Remove-StaleBuilds($dir) {
    $here = ($dir -replace '\\', '/')
    foreach ($b in Get-ChildItem -LiteralPath $dir -Directory -Filter 'cmake-build-*') {
        $stale = $false
        $cache = Join-Path $b.FullName 'CMakeCache.txt'
        if ((Test-Path -LiteralPath $cache) -and ([IO.File]::ReadAllText($cache)) -match '(?m)^CMAKE_HOME_DIRECTORY:INTERNAL=(.*?)\r?$') {
            if ($Matches[1] -ne $here) { $stale = $true }
        }
        $info = Get-ChildItem -LiteralPath (Join-Path $b.FullName 'CMakeFiles') -Recurse -Filter 'CMakeCCompiler.cmake' -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($info -and ([IO.File]::ReadAllText($info.FullName)) -match 'armcc') { $stale = $true }
        if ($stale) {
            Remove-Item -LiteralPath $b.FullName -Recurse -Force
            Write-Host "  已删除过期的 $($b.Name)，CLion 会重新生成"
        }
    }
}

# Same Keil leftovers as the project's cleanup script; Keil regenerates all of them
function Remove-KeilFiles($dir) {
    $removed = 0
    foreach ($name in 'DebugConfig', 'Listings', 'Objects') {
        $path = Join-Path $dir $name
        if (Test-Path -LiteralPath $path -PathType Container) { Remove-Item -LiteralPath $path -Recurse -Force; $removed++ }
    }
    foreach ($pattern in '*.scvd', '*.uvguix.*') {
        foreach ($f in Get-ChildItem -LiteralPath $dir -File -Force -Filter $pattern) { Remove-Item -LiteralPath $f.FullName -Force; $removed++ }
    }
    foreach ($f in Get-ChildItem -LiteralPath $dir -Recurse -File -Force -Filter '*.DS_Store*') { Remove-Item -LiteralPath $f.FullName -Force; $removed++ }
    if ($removed) { Write-Host '  已清理 Keil 中间文件，回到 Keil 后第一次会全部重新编译' }
}

# The device macro Keil's device pack adds by itself, worked out from the startup file's name:
#   startup_stm32f10x_md.s -> STM32F10X_MD    startup_stm32f103xb.s -> STM32F103xB
#   startup_stm32f40_41xxx.s -> STM32F40_41xxx    startup_gd32f30x_hd.s -> GD32F30X_HD    startup_ARMCM4.s -> ARMCM4
# Family-wide names such as startup_stm32f0xx.s do not say which macro is needed, so they give none.
function Get-DeviceDefine($startup, $defines) {
    if (@($defines | Where-Object { $_ -match '^(STM32|GD32|ARMCM|ARMSC)' }).Count) { return '' }
    if ($startup -cmatch '^startup_(ARM(CM|SC)\w+)\.[sS]$') { return $Matches[1] }
    if ($startup -notmatch '^startup_((stm32|gd32)\w+)\.s$') { return '' }
    $n = $Matches[1].ToUpper()
    if ($n -match '^(STM32|GD32)[A-Z]\d(XX|\dX)$') { return '' }
    if ($n -match '^(STM32F10X|STM32L1XX|GD32F\d0X)_') { return $n }
    if ($n -match '^STM32') { return ($n -creplace 'X', 'x') }
    return ''
}

# Memory from the Cpu string, written as IROM(start-end) or IROM(start,size)
function Get-CpuRange($cpuStr, $name) {
    if ($cpuStr -notmatch "$name\((0x[0-9A-Fa-f]+)([-,])(0x[0-9A-Fa-f]+)\)") { return @('', '') }
    $start = $Matches[1]; $sep = $Matches[2]; $last = $Matches[3]
    if ($sep -eq ',') { return @($start, $last) }
    return @($start, ('0x{0:X}' -f ([Convert]::ToInt64($last, 16) - [Convert]::ToInt64($start, 16) + 1)))
}

# Projects using Keil's CMSIS::CORE pack component do not list the folder holding core_cmN.h.
# The Cube packages carry the same headers under Drivers/CMSIS, so look for them above the project.
function Find-CmsisInclude($dir, $incFolders) {
    foreach ($i in $incFolders) {
        if (Get-ChildItem -LiteralPath (Join-Path $dir $i) -Filter 'core_cm*.h' -ErrorAction SilentlyContinue) { return '' }
    }
    $up = ''
    $base = $dir
    for ($n = 0; $n -le 8; $n++) {
        foreach ($sub in 'Drivers/CMSIS/Core/Include', 'Drivers/CMSIS/Include', 'CMSIS/Core/Include', 'CMSIS/Include') {
            if (Get-ChildItem -LiteralPath (Join-Path $base $sub) -Filter 'core_cm*.h' -ErrorAction SilentlyContinue) { return "$up$sub" }
        }
        $parent = Split-Path $base -Parent
        if (-not $parent) { break }
        $base = $parent
        $up += '../'
    }
    return ''
}

# FreeRTOS's portable/RVDS port is ARMCC-only; the same port for GCC sits next to it
function Get-GccPort($dir, $rel) {
    if ($rel -notmatch '/portable/RVDS/') { return $rel }
    $gcc = $rel -replace '/portable/RVDS/', '/portable/GCC/'
    if (Test-Path -LiteralPath (Join-Path $dir $gcc)) { return $gcc }
    return $rel
}

# Keil startup file -> GNU assembler startup file, keeping its vector table and stack/heap sizes
function Convert-Startup($path) {
    $lines = [IO.File]::ReadAllLines($path, $Latin1) | ForEach-Object { ($_ -split ';')[0] }
    $text = $lines -join "`n"
    if ($text -notmatch '(?m)^Stack_Size\s+EQU\s+(0x[0-9A-Fa-f]+|\d+)') { throw "启动文件里找不到 Stack_Size: $path" }
    $stack = $Matches[1]
    if ($text -notmatch '(?m)^Heap_Size\s+EQU\s+(0x[0-9A-Fa-f]+|\d+)') { throw "启动文件里找不到 Heap_Size: $path" }
    $heap = $Matches[1]

    $vectors = @()
    $inTable = $false
    foreach ($l in $lines) {
        if ($l -match '^__Vectors\s+DCD') { $inTable = $true }
        if ($l -match '^__Vectors_End') { break }
        if ($inTable -and $l -match '\bDCD\s+(\w+)') { $vectors += $Matches[1] }
        elseif ($inTable -and $l -match '\bSPACE\s+([\d\s*()]+?)\s*$') { $vectors += "SPACE:$($Matches[1])" }
    }
    if ($vectors.Count -lt 16 -or $vectors[0] -ne '__initial_sp' -or $vectors[1] -ne 'Reset_Handler') {
        throw "启动文件的向量表格式不认识: $path"
    }

    $table = @(); $weak = @()
    foreach ($v in $vectors) {
        if ($v -eq '__initial_sp') { $table += '    .word _estack'; continue }
        if ($v -eq '0') { $table += '    .word 0'; continue }
        if ($v.StartsWith('SPACE:')) { $table += "    .space $($v.Substring(6))"; continue }
        $table += "    .word $v"
        $entry = "    .weak $v`n    .thumb_set $v, Default_Handler"
        if ($v -ne 'Reset_Handler' -and $weak -notcontains $entry) { $weak += $entry }
    }

    $s = @'
@ {MARKER} from {SOURCE}. Do not edit by hand.
    .syntax unified
    .cpu {CPU}
    .thumb

    .section .isr_vector, "a", %progbits
    .global __Vectors
    .global __Vectors_End
    .global __Vectors_Size
    .type __Vectors, %object
__Vectors:
{TABLE}
__Vectors_End:
    .size __Vectors, . - __Vectors
    .set __Vectors_Size, __Vectors_End - __Vectors

    .section .text.Reset_Handler, "ax", %progbits
    .weak Reset_Handler
    .type Reset_Handler, %function
Reset_Handler:
    ldr r0, =_sdata
    ldr r1, =_edata
    ldr r2, =_sidata
    b 2f
1:  ldr r3, [r2]
    str r3, [r0]
    adds r0, #4
    adds r2, #4
2:  cmp r0, r1
    blo 1b
    ldr r0, =_sbss
    ldr r1, =_ebss
    movs r2, #0
    b 4f
3:  str r2, [r0]
    adds r0, #4
4:  cmp r0, r1
    blo 3b
    bl SystemInit
    bl __libc_init_array
    bl main
5:  b 5b
    .size Reset_Handler, . - Reset_Handler

    .section .text.Default_Handler, "ax", %progbits
    .type Default_Handler, %function
Default_Handler:
    b .
    .size Default_Handler, . - Default_Handler

{WEAK}
'@
    return @{
        Text  = $s.Replace('{SOURCE}', (Split-Path $path -Leaf)).Replace('{TABLE}', ($table -join "`n")).Replace('{WEAK}', ($weak -join "`n"))
        Stack = $stack
        Heap  = $heap
    }
}

function Convert-Project($dir) {
    $uv = @(Get-ChildItem -LiteralPath $dir -Filter *.uvprojx | Sort-Object Name)
    if ($uv.Count -gt 1) { Write-Host "  注意: 有多个 .uvprojx，使用 $($uv[0].Name)" }

    $outFile = Join-Path $dir 'CMakeLists.txt'
    if ((Test-Path -LiteralPath $outFile) -and -not ([IO.File]::ReadAllText($outFile)).Contains($Marker)) {
        throw 'CMakeLists.txt 已存在且不是本脚本生成的，未覆盖。'
    }

    $xml = New-Object xml
    $xml.Load($uv[0].FullName)
    $targets = $xml.SelectNodes('/Project/Targets/Target')
    if ($targets.Count -gt 1) { Write-Host "  注意: 有多个 Target，使用第一个" }
    $t = $targets[0]

    # Sources, in Keil's order
    $cSrc = @(); $asmSrc = @()
    foreach ($group in $t.SelectNodes('Groups/Group')) {
        if ((Get-Opt $group 'GroupOption/CommonProperty/IncludeInBuild') -eq '0') { continue }
        foreach ($f in $group.SelectNodes('Files/File')) {
            if ((Get-Opt $f 'FileOption/CommonProperty/IncludeInBuild') -eq '0') { continue }
            $rel = Get-RelPath (Get-Opt $f 'FilePath')
            $type = Get-Opt $f 'FileType'
            if ($type -notin '1', '2', '3', '4', '8') { continue }
            if ($type -eq '8') { throw "不支持 C++ 源文件: $rel" }
            if ($type -in '3', '4') { throw "Keil 编译好的库或目标文件不能给 GCC 用: $rel" }
            if (-not (Test-Path -LiteralPath (Join-Path $dir $rel))) { throw "工程里列出的文件不存在: $rel" }
            if ($type -eq '1') { $cSrc += $rel } else { $asmSrc += $rel }
        }
    }
    if ($asmSrc.Count -ne 1) { throw "工程里应当正好有 1 个启动文件（.s），实际 $($asmSrc.Count) 个。" }

    # CPU
    $cpuStr = Get-Opt $t 'TargetOption/TargetCommonOption/Cpu'
    if ($cpuStr -notmatch 'CPUTYPE\("([^"]+)"\)') { throw "读不出 CPU 型号: $cpuStr" }
    $cpu = $Matches[1].ToLower()
    if ($cpu -notmatch '^cortex-m') { throw "只支持 Cortex-M 内核，这个工程是 $cpu。" }
    $cpu = $cpu.Replace('+', 'plus')
    $archFlags = "-mcpu=$cpu -mthumb"
    $ads = 'TargetOption/TargetArmAds'

    # Floating Point Hardware on the Target page: 2 is single precision, 3 is double precision.
    # Projects copied between devices can keep this setting on a core without an FPU, so the Cpu string decides too.
    $fpuSetting = Get-Opt $t "$ads/ArmAdsMisc/RvdsVP"
    if ($fpuSetting -in '2', '3' -and $cpuStr -match 'FPU\d') {
        $fpu = 'auto'
        if ($cpu -eq 'cortex-m4') { $fpu = 'fpv4-sp-d16' }
        if ($cpu -eq 'cortex-m7') { $fpu = if ($fpuSetting -eq '3') { 'fpv5-d16' } else { 'fpv5-sp-d16' } }
        $archFlags += " -mfpu=$fpu -mfloat-abi=hard"
    }

    # Memory layout from Options for Target > Target
    $mem = "$ads/ArmAdsMisc/OnChipMemories"
    $romBase = Get-Opt $t "$mem/OCR_RVCT4/StartAddress"; $romSize = Get-Opt $t "$mem/OCR_RVCT4/Size"
    $ramBase = Get-Opt $t "$mem/OCR_RVCT9/StartAddress"; $ramSize = Get-Opt $t "$mem/OCR_RVCT9/Size"
    if ($romSize -in '', '0x0') { $romBase, $romSize = Get-CpuRange $cpuStr 'IROM' }
    if ($ramSize -in '', '0x0') { $ramBase, $ramSize = Get-CpuRange $cpuStr 'IRAM' }
    if ($romSize -in '', '0x0' -or $ramSize -in '', '0x0') { throw '读不出 Flash 或 RAM 的地址，请检查 Options for Target 的 Target 页。' }
    if ((Get-Opt $t "$ads/LDads/umfTarg") -eq '0' -and (Get-Opt $t "$ads/LDads/ScatterFile")) {
        Write-Host '  注意: 工程用了自定义 .sct，GCC 用不了，已按 Target 页的内存布局生成链接脚本'
    }

    # C options
    $cOpt = @('-g', '-ffunction-sections', '-fdata-sections')
    switch (Get-Opt $t "$ads/Cads/Optim") { '1' { $cOpt += '-O0' } '2' { $cOpt += '-O1' } '3' { $cOpt += '-O2' } '4' { $cOpt += '-O3' } default { $cOpt += '-O2' } }
    $cMisc = Get-Opt $t "$ads/Cads/VariousControls/MiscControls"
    if ((Get-Opt $t 'uAC6') -eq '1') { $cOpt += '-std=gnu11' }
    elseif ((Get-Opt $t "$ads/Cads/uC99") -eq '1' -or $cMisc -match '--c99') { $cOpt += '-std=gnu99' }
    else { $cOpt += '-std=gnu90' }
    if ((Get-Opt $t "$ads/Cads/EnumInt") -eq '0') { $cOpt += '-fshort-enums' }
    if ((Get-Opt $t "$ads/Cads/PlainCh") -eq '1') { $cOpt += '-fsigned-char' } else { $cOpt += '-funsigned-char' }
    switch (Get-Opt $t "$ads/Cads/wLevel") { '1' { $cOpt += '-w' } '2' { $cOpt += '-Wall' } }
    if (($cMisc -replace '(?i)--c99', '').Trim()) { Write-Host '  注意: C/C++ 页的 Misc Controls 是 ARMCC 选项，已忽略' }

    # Defines: Keil adds the device macro itself, it is not in the project's Define box
    $startupPath = Join-Path $dir $asmSrc[0]
    $defs = @(Split-Semi (Get-Opt $t "$ads/Cads/VariousControls/Define") | Select-Object -Unique)
    $deviceDefine = Get-DeviceDefine (Split-Path $startupPath -Leaf) $defs
    $deviceBlock = ''
    if ($deviceDefine) {
        $deviceBlock = "# Added by Keil's device pack, so it is not in the project's Define box`nset(KEIL_DEVICE_DEFINE $deviceDefine)`n`n"
        $defs += '${KEIL_DEVICE_DEFINE}'
    } elseif (-not @($defs | Where-Object { $_ -match '^(STM32|GD32|ARMCM|ARMSC)' }).Count) {
        Write-Host "  注意: 没能从 $(Split-Path $startupPath -Leaf) 判断型号宏。如果编译时报缺少器件宏，请在 Keil 的 Define 框里加上，比如 STM32F407xx"
    }
    $incFolders = @(Split-Semi (Get-Opt $t "$ads/Cads/VariousControls/IncludePath") | ForEach-Object { Get-GccPort $dir (Get-RelPath $_) })
    $incs = @($incFolders | ForEach-Object { '${CMAKE_CURRENT_SOURCE_DIR}/' + $_ })
    $cmsisInclude = Find-CmsisInclude $dir $incFolders
    if ($cmsisInclude) {
        $deviceBlock = "# Keil takes these headers from its CMSIS pack, so they are not in the project's include paths`nset(KEIL_CMSIS_INCLUDE `"`${CMAKE_CURRENT_SOURCE_DIR}/$cmsisInclude`")`n`n" + $deviceBlock
        $incs += '${KEIL_CMSIS_INCLUDE}'
    } elseif ($t.OuterXml -match 'Cclass="CMSIS"' -and -not @($incFolders | Where-Object { Get-ChildItem -LiteralPath (Join-Path $dir $_) -Filter 'core_cm*.h' -ErrorAction SilentlyContinue }).Count) {
        Write-Host '  注意: 工程用的是 Keil 的 CMSIS 包，没找到 core_cmN.h。请把这些头文件放进工程，并在 Keil 里加上头文件路径'
    }

    $name = Get-Opt $t 'TargetOption/TargetCommonOption/OutputName'
    if (-not $name) { $name = [IO.Path]::GetFileNameWithoutExtension($uv[0].Name) }
    $target = ($name -replace '[^A-Za-z0-9_]', '_')

    # What the application needs from the C library, which Keil's MicroLIB gave it implicitly
    $code = ($cSrc | Where-Object { $_ -notmatch '^(Library|Start)/' } | ForEach-Object {
        [IO.File]::ReadAllText((Join-Path $dir $_), $Latin1)
    }) -join "`n"
    $code = [regex]::Replace($code, '/\*[\s\S]*?\*/|//[^\n]*', '')
    # ST's examples define __io_putchar for GCC and keep fputc only inside a #define for other compilers
    $hasIoPutchar = $code -match '\b__io_putchar\b'
    $hasFputc = $code -match '(?m)^(?!\s*#).*\bint\s+fputc\s*\('
    $linkOpt = @('-Wl,--gc-sections', ('-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/' + $name + '.map'), '-T${CMAKE_CURRENT_SOURCE_DIR}/cmake/Project.ld')
    if ($code -match '%[-+ #0]*\d*(\.\d+)?l?[fFeEgG]') {
        $linkOpt += '-u _printf_float'
        if ($code -match '\bscanf\s*\(') { $linkOpt += '-u _scanf_float' }
    }

    $cmakeDir = Join-Path $dir 'cmake'
    New-Item -ItemType Directory -Force $cmakeDir | Out-Null
    Remove-Stale (Join-Path $cmakeDir 'armcc-toolchain.cmake')
    Remove-Stale (Join-Path $cmakeDir 'Project.sct')
    Remove-StaleBuilds $dir
    Remove-KeilFiles $dir

    # Startup file
    $startup = Convert-Startup $startupPath
    Save-Text (Join-Path $cmakeDir 'startup_gcc.s') $startup.Text.Replace('{MARKER}', $Marker).Replace('{CPU}', $cpu)
    $srcList = @('cmake/startup_gcc.s')

    # core_cmN.c: its STREX inline assembly lets GCC use the same register twice, which the assembler rejects
    foreach ($c in $cSrc) {
        if ((Split-Path $c -Leaf) -match '^(core_cm\d+)\.c$') {
            $coreName = "$($Matches[1].ToLower())_gcc.c"
            $coreText = [IO.File]::ReadAllText((Join-Path $dir $c), $Latin1)
            $coreText = [regex]::Replace($coreText, '(strex[bh]?\s+%0[^\n]*?)"=r"', '$1"=&r"')
            [IO.File]::WriteAllText((Join-Path $cmakeDir $coreName), "/* $Marker from $c */`n" + $coreText, $Latin1)
            $srcList += "cmake/$coreName"
        } else {
            $srcList += (Get-GccPort $dir $c)
        }
    }

    # printf: Keil's MicroLIB calls fputc, GCC's newlib calls _write and buffers stdout
    $compatFile = Join-Path $cmakeDir 'keil_compat.c'
    if ($hasFputc -or $hasIoPutchar) {
        # Weak because board support code can mention __io_putchar in a part that is compiled out
        $putcharDecl = if ($hasIoPutchar) { "int __io_putchar(int ch) __attribute__((weak));`n`n" } else { '' }
        $putcharCall = if ($hasIoPutchar) { 'if (__io_putchar) __io_putchar((unsigned char)buf[i])' } else { 'fputc((unsigned char)buf[i], stdout)' }
        $compat = @'
/* {MARKER}. Routes printf to the project's own output function, as Keil's MicroLIB does. */
#include <stdio.h>

{DECL}int _write(int fd, char *buf, int len)
{
    int i;
    (void)fd;
    for (i = 0; i < len; i++) {
        {CALL};
    }
    return len;
}

__attribute__((constructor)) static void keil_compat_stdio_init(void)
{
    setvbuf(stdout, NULL, _IONBF, 0);
}
'@
        Save-Text $compatFile $compat.Replace('{MARKER}', $Marker).Replace('{DECL}', $putcharDecl).Replace('{CALL}', $putcharCall)
        $srcList += 'cmake/keil_compat.c'
    } else {
        Remove-Stale $compatFile
    }

    # Linker script
    $ld = @'
/* {MARKER}. Memory layout from the Keil project's Target page; stack and heap sizes from its startup file. */
ENTRY(Reset_Handler)

_estack = ORIGIN(RAM) + LENGTH(RAM);
_Min_Stack_Size = {STACK};
_Min_Heap_Size = {HEAP};

MEMORY
{
    FLASH (rx)  : ORIGIN = {ROMBASE}, LENGTH = {ROMSIZE}
    RAM   (xrw) : ORIGIN = {RAMBASE}, LENGTH = {RAMSIZE}
}

SECTIONS
{
    .isr_vector :
    {
        . = ALIGN(4);
        KEEP(*(.isr_vector))
        . = ALIGN(4);
    } >FLASH

    .text :
    {
        . = ALIGN(4);
        *(.text)
        *(.text*)
        *(.glue_7)
        *(.glue_7t)
        *(.eh_frame)
        KEEP(*(.init))
        KEEP(*(.fini))
        . = ALIGN(4);
        _etext = .;
    } >FLASH

    .rodata :
    {
        . = ALIGN(4);
        *(.rodata)
        *(.rodata*)
        . = ALIGN(4);
    } >FLASH

    .ARM.extab : { *(.ARM.extab* .gnu.linkonce.armextab.*) } >FLASH
    .ARM :
    {
        __exidx_start = .;
        *(.ARM.exidx*)
        __exidx_end = .;
    } >FLASH

    .preinit_array :
    {
        PROVIDE_HIDDEN(__preinit_array_start = .);
        KEEP(*(.preinit_array*))
        PROVIDE_HIDDEN(__preinit_array_end = .);
    } >FLASH
    .init_array :
    {
        PROVIDE_HIDDEN(__init_array_start = .);
        KEEP(*(SORT(.init_array.*)))
        KEEP(*(.init_array*))
        PROVIDE_HIDDEN(__init_array_end = .);
    } >FLASH
    .fini_array :
    {
        PROVIDE_HIDDEN(__fini_array_start = .);
        KEEP(*(SORT(.fini_array.*)))
        KEEP(*(.fini_array*))
        PROVIDE_HIDDEN(__fini_array_end = .);
    } >FLASH

    _sidata = LOADADDR(.data);

    .data :
    {
        . = ALIGN(4);
        _sdata = .;
        *(.data)
        *(.data*)
        . = ALIGN(4);
        _edata = .;
    } >RAM AT> FLASH

    .bss :
    {
        . = ALIGN(4);
        _sbss = .;
        __bss_start__ = _sbss;
        *(.bss)
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = .;
        __bss_end__ = _ebss;
    } >RAM

    ._user_heap_stack (NOLOAD) :
    {
        . = ALIGN(8);
        PROVIDE(end = .);
        PROVIDE(_end = .);
        . = . + _Min_Heap_Size;
        . = . + _Min_Stack_Size;
        . = ALIGN(8);
    } >RAM

    .ARM.attributes 0 : { *(.ARM.attributes) }
}
'@
    Save-Text (Join-Path $cmakeDir 'Project.ld') $ld.Replace('{MARKER}', $Marker).Replace('{ROMBASE}', $romBase).Replace('{ROMSIZE}', $romSize).Replace('{RAMBASE}', $ramBase).Replace('{RAMSIZE}', $ramSize).Replace('{STACK}', $startup.Stack).Replace('{HEAP}', $startup.Heap)

    # Toolchain: no absolute paths from this machine, so the folder also builds on macOS and Linux
    $toolchain = @'
# {MARKER}. Do not edit by hand.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# IDEs started from the desktop often lack the shell's PATH, so look in the usual install folders too
file(GLOB ARM_GCC_HINTS
    "$ENV{ARM_GCC_ROOT}/bin"
    "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/*/bin"
    "C:/Program Files/Arm GNU Toolchain arm-none-eabi/*/bin"
    "/Applications/ArmGNUToolchain/*/arm-none-eabi/bin"
    "/opt/homebrew/bin"
    "/usr/local/bin"
)
find_program(ARM_GCC arm-none-eabi-gcc HINTS ${ARM_GCC_HINTS})
if(NOT ARM_GCC)
    message(FATAL_ERROR "arm-none-eabi-gcc not found. Install the Arm GNU Toolchain or set the ARM_GCC_ROOT environment variable.")
endif()
get_filename_component(ARM_GCC_BIN "${ARM_GCC}" DIRECTORY)

set(CMAKE_C_COMPILER "${ARM_GCC}")
set(CMAKE_ASM_COMPILER "${ARM_GCC}")
find_program(ARM_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_GCC_BIN}")
find_program(ARM_SIZE arm-none-eabi-size HINTS "${ARM_GCC_BIN}")

set(CMAKE_C_FLAGS_INIT "{ARCH}")
set(CMAKE_ASM_FLAGS_INIT "{ARCH}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "{ARCH} --specs=nano.specs --specs=nosys.specs")
'@
    Save-Text (Join-Path $cmakeDir 'arm-none-eabi-toolchain.cmake') $toolchain.Replace('{MARKER}', $Marker).Replace('{ARCH}', $archFlags)

    function Fmt($items) {
        return ($items | ForEach-Object {
            if ($_ -match '^-u ') { '    "SHELL:' + $_ + '"' } elseif ($_ -match '\s') { '    "' + $_ + '"' } else { "    $_" }
        }) -join "`n"
    }
    function FmtC($items) {
        return ($items | ForEach-Object {
            if ($_ -match '\s') { "    `"`$<`$<COMPILE_LANGUAGE:C>:$_>`"" } else { "    `$<`$<COMPILE_LANGUAGE:C>:$_>" }
        }) -join "`n"
    }

    $cmakeText = @'
# {MARKER} from {UVPROJX}. Re-run it after adding files in Keil; do not edit by hand.
cmake_minimum_required(VERSION 3.20)

if(NOT CMAKE_TOOLCHAIN_FILE)
    set(CMAKE_TOOLCHAIN_FILE "${CMAKE_CURRENT_SOURCE_DIR}/cmake/arm-none-eabi-toolchain.cmake")
endif()

project({TARGET} LANGUAGES C ASM)

{DEVICE}# Build settings come from the Keil project, whichever CLion profile is selected
foreach(cfg DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set(CMAKE_C_FLAGS_${cfg} "")
    set(CMAKE_ASM_FLAGS_${cfg} "")
    set(CMAKE_EXE_LINKER_FLAGS_${cfg} "")
endforeach()

add_executable({TARGET}
{SRC}
)
set_target_properties({TARGET} PROPERTIES OUTPUT_NAME "{NAME}" SUFFIX ".elf")

target_include_directories({TARGET} PRIVATE
{INCS}
)
target_compile_definitions({TARGET} PRIVATE
{DEFS}
)
target_compile_options({TARGET} PRIVATE
{COPT}
)
target_link_options({TARGET} PRIVATE
{LOPT}
)
set_target_properties({TARGET} PROPERTIES LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/cmake/Project.ld")

add_custom_command(TARGET {TARGET} POST_BUILD
    COMMAND "${ARM_OBJCOPY}" -O ihex "$<TARGET_FILE_NAME:{TARGET}>" "{NAME}.hex"
    COMMAND "${ARM_SIZE}" "$<TARGET_FILE_NAME:{TARGET}>"
    COMMENT "Creating {NAME}.hex"
)

# Build this target to flash the board, using whichever programmer is installed
find_program(ST_LINK_CLI ST-LINK_CLI PATHS
    "C:/Program Files (x86)/STMicroelectronics/STM32 ST-LINK Utility/ST-LINK Utility"
    "C:/Program Files/STMicroelectronics/STM32 ST-LINK Utility/ST-LINK Utility"
)
find_program(ST_FLASH st-flash PATHS /opt/homebrew/bin /usr/local/bin)
find_program(OPENOCD openocd PATHS /opt/homebrew/bin /usr/local/bin)
if(ST_LINK_CLI)
    set(FLASH_COMMAND "${ST_LINK_CLI}" -c SWD -P "{NAME}.hex" -V after_programming -Rst)
elseif(ST_FLASH)
    set(FLASH_COMMAND "${ST_FLASH}" --reset --format ihex write "{NAME}.hex")
{OCD}else()
    set(FLASH_COMMAND "${CMAKE_COMMAND}" -E echo "No programmer found: install ST-LINK Utility, stlink or OpenOCD" COMMAND "${CMAKE_COMMAND}" -E false)
endif()
add_custom_target(flash COMMAND ${FLASH_COMMAND} DEPENDS {TARGET} WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}" USES_TERMINAL VERBATIM)
'@
    # OpenOCD names its chip configurations by family, unlike the other two programmers
    $ocdBlock = ''
    $ocdCfg = ''
    if ((Get-Opt $t 'TargetOption/TargetCommonOption/Device') -match '^STM32(F[0-47]|G[04]|H7|L[0145]|U5|WB|WL)') {
        $family = $Matches[1].ToLower()
        $ocdCfg = if ($family -in 'l0', 'l1') { "stm32$family" } else { "stm32${family}x" }
        $ocdBlock = "elseif(OPENOCD)`n    set(FLASH_COMMAND `"`${OPENOCD}`" -f interface/stlink.cfg -f target/$ocdCfg.cfg -c `"program {NAME}.hex verify reset exit`")`n"
    }
    $cmakeText = $cmakeText.Replace('{OCD}', $ocdBlock)
    $cmakeText = $cmakeText.Replace('{MARKER}', $Marker).Replace('{UVPROJX}', $uv[0].Name).Replace('{TARGET}', $target).Replace('{NAME}', $name).Replace('{DEVICE}', $deviceBlock)
    $cmakeText = $cmakeText.Replace('{SRC}', (Fmt $srcList)).Replace('{INCS}', (FmtC $incs)).Replace('{DEFS}', (FmtC $defs)).Replace('{COPT}', (FmtC $cOpt)).Replace('{LOPT}', (Fmt $linkOpt))
    Save-Text $outFile $cmakeText

    # CLion's OpenOCD run configuration: Run flashes the board, Debug also stops at breakpoints
    if ($ocdCfg) {
        Save-Text (Join-Path $cmakeDir 'stlink.cfg') "# $Marker. Do not edit by hand.`nsource [find interface/stlink.cfg]`nsource [find target/$ocdCfg.cfg]`nreset_config none"
        $runDir = Join-Path $dir '.run'
        New-Item -ItemType Directory -Force $runDir | Out-Null
        $runConfig = @'
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="OpenOCD" type="com.jetbrains.cidr.embedded.openocd.conf.type" factoryName="com.jetbrains.cidr.embedded.openocd.conf.factory" REDIRECT_INPUT="false" ELEVATE="false" USE_EXTERNAL_CONSOLE="false" EMULATE_TERMINAL="false" PASS_PARENT_ENVS_2="true" PROJECT_NAME="{TARGET}" TARGET_NAME="{TARGET}" CONFIG_NAME="Debug" RUN_TARGET_PROJECT_NAME="{TARGET}" RUN_TARGET_NAME="{TARGET}">
    <openocd board-config="$PROJECT_DIR$/cmake/stlink.cfg" gdb-port="3333" telnet-port="4444" reset-type="INIT" download-type="ALWAYS" />
    <method v="2">
      <option name="com.jetbrains.cidr.execution.CidrBuildBeforeRunTaskProvider$BuildBeforeRunTask" enabled="true" />
    </method>
  </configuration>
</component>
'@
        Save-Text (Join-Path $runDir 'OpenOCD.run.xml') $runConfig.Replace('{TARGET}', $target)
    }

    Write-Host "  完成: $($cSrc.Count) 个 C 文件, CPU $cpu, 宏 $((@($defs | Where-Object { $_ -notmatch '^\$' }) + $deviceDefine | Where-Object { $_ }) -join ' ')"
}

try {
    $root = if ($env:K2C_ARG) { $env:K2C_ARG } else { (Get-Location).Path }
    if (-not (Test-Path -LiteralPath $root -PathType Container)) { throw "不是文件夹: $root" }
    if (Get-ChildItem -LiteralPath $root -Filter *.uvprojx) {
        $projects = @((Resolve-Path -LiteralPath $root).Path)
    } else {
        $projects = @(Get-ChildItem -LiteralPath $root -Directory | Where-Object {
            Get-ChildItem -LiteralPath $_.FullName -Filter *.uvprojx
        } | ForEach-Object { $_.FullName })
    }
    if (-not $projects) { throw "$root 及其子文件夹里没有 .uvprojx 工程。" }

    $failed = 0
    foreach ($p in $projects) {
        Write-Host "`n$p"
        try { Convert-Project $p }
        catch { Write-Host "  失败: $($_.Exception.Message)" -ForegroundColor Red; $failed++ }
    }
    if ($failed) { exit 1 }
    Write-Host "`n用 CLion 打开工程文件夹即可编译，输出在 cmake-build-debug 里。"
    exit 0
} catch {
    Write-Host "失败: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}
