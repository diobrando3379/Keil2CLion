@echo off
rem Keil2CLion: generate an arm-none-eabi-gcc CMake project next to a Keil5 project. Keil files are never touched.
rem Usage: drag a project folder onto this file, or double-click to convert every project next to it.
chcp 65001 >nul
setlocal
set "K2C_BAT=%~f0"
set "K2C_ARG=%~1"
powershell -NoProfile -Command "$s=[IO.File]::ReadAllText($env:K2C_BAT,[Text.Encoding]::UTF8); Invoke-Expression $s.Substring($s.IndexOf('#'+'__PS__'))"
set "K2C_RC=%errorlevel%"
if not defined K2C_NOPAUSE pause
exit /b %K2C_RC%

#__PS__
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
# Keep the generated files identical to what Keil2CLion.command writes
$Marker = 'Generated by Keil2CLion'
$Latin1 = [Text.Encoding]::GetEncoding(28591)

function Get-Opt($node, $path) {
    $n = $node.SelectSingleNode($path)
    if ($n) { return $n.InnerText.Trim() }
    return ''
}

function Split-Semi($text) {
    return @($text -split '[;,]' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
}

function Get-RelPath($path) {
    return (($path -replace '\\', '/') -replace '^(\./)+', '')
}

function Save-Text($path, $text) {
    [IO.File]::WriteAllText($path, (($text -replace "`r`n", "`n") + "`n"), (New-Object Text.UTF8Encoding($false)))
}

# Files this script generated for an earlier version of itself or for a project that no longer needs them
function Remove-Stale($path) {
    if ((Test-Path -LiteralPath $path) -and ([IO.File]::ReadAllText($path)).Contains($Marker)) {
        Remove-Item -LiteralPath $path -Force
    }
}

# A build folder keeps the compiler and source path it was configured with, so one copied from
# another computer or configured with Keil's compiler has to be recreated
function Remove-StaleBuilds($dir) {
    $here = ($dir -replace '\\', '/')
    foreach ($b in Get-ChildItem -LiteralPath $dir -Directory -Filter 'cmake-build-*') {
        $stale = $false
        $cache = Join-Path $b.FullName 'CMakeCache.txt'
        if ((Test-Path -LiteralPath $cache) -and ([IO.File]::ReadAllText($cache)) -match '(?m)^CMAKE_HOME_DIRECTORY:INTERNAL=(.*?)\r?$') {
            if ($Matches[1] -ne $here) { $stale = $true }
        }
        $info = Get-ChildItem -LiteralPath (Join-Path $b.FullName 'CMakeFiles') -Recurse -Filter 'CMakeCCompiler.cmake' -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($info -and ([IO.File]::ReadAllText($info.FullName)) -match 'armcc') { $stale = $true }
        if ($stale) {
            Remove-Item -LiteralPath $b.FullName -Recurse -Force
            Write-Host "  已删除过期的 $($b.Name)，CLion 会重新生成"
        }
    }
}

# Same Keil leftovers as the project's cleanup script; Keil regenerates all of them
function Remove-KeilFiles($dir) {
    $removed = 0
    foreach ($name in 'DebugConfig', 'Listings', 'Objects') {
        $path = Join-Path $dir $name
        if (Test-Path -LiteralPath $path -PathType Container) { Remove-Item -LiteralPath $path -Recurse -Force; $removed++ }
    }
    foreach ($pattern in '*.scvd', '*.uvguix.*') {
        foreach ($f in Get-ChildItem -LiteralPath $dir -File -Force -Filter $pattern) { Remove-Item -LiteralPath $f.FullName -Force; $removed++ }
    }
    foreach ($f in Get-ChildItem -LiteralPath $dir -Recurse -File -Force -Filter '*.DS_Store*') { Remove-Item -LiteralPath $f.FullName -Force; $removed++ }
    if ($removed) { Write-Host '  已清理 Keil 中间文件，回到 Keil 后第一次会全部重新编译' }
}

# Keil startup file -> GNU assembler startup file, keeping its vector table and stack/heap sizes
function Convert-Startup($path) {
    $lines = [IO.File]::ReadAllLines($path, $Latin1) | ForEach-Object { ($_ -split ';')[0] }
    $text = $lines -join "`n"
    if ($text -notmatch '(?m)^Stack_Size\s+EQU\s+(0x[0-9A-Fa-f]+|\d+)') { throw "启动文件里找不到 Stack_Size: $path" }
    $stack = $Matches[1]
    if ($text -notmatch '(?m)^Heap_Size\s+EQU\s+(0x[0-9A-Fa-f]+|\d+)') { throw "启动文件里找不到 Heap_Size: $path" }
    $heap = $Matches[1]

    $vectors = @()
    $inTable = $false
    foreach ($l in $lines) {
        if ($l -match '^__Vectors\s+DCD') { $inTable = $true }
        if ($l -match '^__Vectors_End') { break }
        if ($inTable -and $l -match '\bDCD\s+(\w+)') { $vectors += $Matches[1] }
    }
    if ($vectors.Count -lt 16 -or $vectors[0] -ne '__initial_sp' -or $vectors[1] -ne 'Reset_Handler') {
        throw "启动文件的向量表格式不认识: $path"
    }

    $table = @(); $weak = @()
    foreach ($v in $vectors) {
        switch ($v) {
            '__initial_sp' { $table += '    .word _estack' }
            '0' { $table += '    .word 0' }
            default {
                $table += "    .word $v"
                if ($v -ne 'Reset_Handler') { $weak += "    .weak $v`n    .thumb_set $v, Default_Handler" }
            }
        }
    }

    $s = @'
@ {MARKER} from {SOURCE}. Do not edit by hand.
    .syntax unified
    .cpu {CPU}
    .thumb

    .section .isr_vector, "a", %progbits
    .type g_pfnVectors, %object
g_pfnVectors:
{TABLE}
    .size g_pfnVectors, . - g_pfnVectors

    .section .text.Reset_Handler, "ax", %progbits
    .weak Reset_Handler
    .type Reset_Handler, %function
Reset_Handler:
    ldr r0, =_sdata
    ldr r1, =_edata
    ldr r2, =_sidata
1:  cmp r0, r1
    ittt lo
    ldrlo r3, [r2], #4
    strlo r3, [r0], #4
    blo 1b
    ldr r0, =_sbss
    ldr r1, =_ebss
    movs r2, #0
2:  cmp r0, r1
    itt lo
    strlo r2, [r0], #4
    blo 2b
    bl SystemInit
    bl __libc_init_array
    bl main
3:  b 3b
    .size Reset_Handler, . - Reset_Handler

    .section .text.Default_Handler, "ax", %progbits
    .type Default_Handler, %function
Default_Handler:
    b .
    .size Default_Handler, . - Default_Handler

{WEAK}
'@
    return @{
        Text  = $s.Replace('{SOURCE}', (Split-Path $path -Leaf)).Replace('{TABLE}', ($table -join "`n")).Replace('{WEAK}', ($weak -join "`n"))
        Stack = $stack
        Heap  = $heap
    }
}

function Convert-Project($dir) {
    $uv = @(Get-ChildItem -LiteralPath $dir -Filter *.uvprojx | Sort-Object Name)
    if ($uv.Count -gt 1) { Write-Host "  注意: 有多个 .uvprojx，使用 $($uv[0].Name)" }

    $outFile = Join-Path $dir 'CMakeLists.txt'
    if ((Test-Path -LiteralPath $outFile) -and -not ([IO.File]::ReadAllText($outFile)).Contains($Marker)) {
        throw 'CMakeLists.txt 已存在且不是本脚本生成的，未覆盖。'
    }

    $xml = New-Object xml
    $xml.Load($uv[0].FullName)
    $targets = $xml.SelectNodes('/Project/Targets/Target')
    if ($targets.Count -gt 1) { Write-Host "  注意: 有多个 Target，使用第一个" }
    $t = $targets[0]

    # Sources, in Keil's order
    $cSrc = @(); $asmSrc = @()
    foreach ($group in $t.SelectNodes('Groups/Group')) {
        if ((Get-Opt $group 'GroupOption/CommonProperty/IncludeInBuild') -eq '0') { continue }
        foreach ($f in $group.SelectNodes('Files/File')) {
            if ((Get-Opt $f 'FileOption/CommonProperty/IncludeInBuild') -eq '0') { continue }
            $rel = Get-RelPath (Get-Opt $f 'FilePath')
            $type = Get-Opt $f 'FileType'
            if ($type -notin '1', '2', '3', '4', '8') { continue }
            if ($type -eq '8') { throw "不支持 C++ 源文件: $rel" }
            if ($type -in '3', '4') { throw "Keil 编译好的库或目标文件不能给 GCC 用: $rel" }
            if (-not (Test-Path -LiteralPath (Join-Path $dir $rel))) { throw "工程里列出的文件不存在: $rel" }
            if ($type -eq '1') { $cSrc += $rel } else { $asmSrc += $rel }
        }
    }
    if ($asmSrc.Count -ne 1) { throw "工程里应当正好有 1 个启动文件（.s），实际 $($asmSrc.Count) 个。" }

    # CPU
    $cpuStr = Get-Opt $t 'TargetOption/TargetCommonOption/Cpu'
    if ($cpuStr -notmatch 'CPUTYPE\("([^"]+)"\)') { throw "读不出 CPU 型号: $cpuStr" }
    $cpu = $Matches[1].ToLower()
    $archFlags = "-mcpu=$cpu -mthumb"
    if ($cpuStr -match 'FPU2') { $archFlags += ' -mfpu=fpv4-sp-d16 -mfloat-abi=hard' }

    # Memory layout from Options for Target > Target
    $ads = 'TargetOption/TargetArmAds'
    $mem = "$ads/ArmAdsMisc/OnChipMemories"
    $romBase = Get-Opt $t "$mem/OCR_RVCT4/StartAddress"; $romSize = Get-Opt $t "$mem/OCR_RVCT4/Size"
    $ramBase = Get-Opt $t "$mem/OCR_RVCT9/StartAddress"; $ramSize = Get-Opt $t "$mem/OCR_RVCT9/Size"
    if ((Get-Opt $t "$ads/LDads/umfTarg") -eq '0' -and (Get-Opt $t "$ads/LDads/ScatterFile")) {
        Write-Host '  注意: 工程用了自定义 .sct，GCC 用不了，已按 Target 页的内存布局生成链接脚本'
    }

    # C options
    $cOpt = @('-g', '-ffunction-sections', '-fdata-sections')
    switch (Get-Opt $t "$ads/Cads/Optim") { '1' { $cOpt += '-O0' } '2' { $cOpt += '-O1' } '3' { $cOpt += '-O2' } '4' { $cOpt += '-O3' } default { $cOpt += '-O2' } }
    if ((Get-Opt $t "$ads/Cads/uC99") -eq '1') { $cOpt += '-std=gnu99' } else { $cOpt += '-std=gnu90' }
    if ((Get-Opt $t "$ads/Cads/EnumInt") -eq '0') { $cOpt += '-fshort-enums' }
    if ((Get-Opt $t "$ads/Cads/PlainCh") -eq '1') { $cOpt += '-fsigned-char' } else { $cOpt += '-funsigned-char' }
    switch (Get-Opt $t "$ads/Cads/wLevel") { '1' { $cOpt += '-w' } '2' { $cOpt += '-Wall' } }
    if (Get-Opt $t "$ads/Cads/VariousControls/MiscControls") { Write-Host '  注意: C/C++ 页的 Misc Controls 是 ARMCC 选项，已忽略' }

    # Defines: Keil adds the density macro itself, it is not in the project's Define box
    $startupPath = Join-Path $dir $asmSrc[0]
    $defs = @(Split-Semi (Get-Opt $t "$ads/Cads/VariousControls/Define"))
    if ((Split-Path $startupPath -Leaf) -match '^startup_stm32f10x_(\w+)\.s$') { $defs += "STM32F10X_$($Matches[1].ToUpper())" }
    $defs = @($defs | Select-Object -Unique)
    $incs = @(Split-Semi (Get-Opt $t "$ads/Cads/VariousControls/IncludePath") | ForEach-Object { '${CMAKE_CURRENT_SOURCE_DIR}/' + (Get-RelPath $_) })

    $name = Get-Opt $t 'TargetOption/TargetCommonOption/OutputName'
    if (-not $name) { $name = [IO.Path]::GetFileNameWithoutExtension($uv[0].Name) }
    $target = ($name -replace '[^A-Za-z0-9_]', '_')

    # What the application needs from the C library, which Keil's MicroLIB gave it implicitly
    $code = ($cSrc | Where-Object { $_ -notmatch '^(Library|Start)/' } | ForEach-Object {
        [IO.File]::ReadAllText((Join-Path $dir $_), $Latin1)
    }) -join "`n"
    $code = [regex]::Replace($code, '/\*[\s\S]*?\*/|//[^\n]*', '')
    $hasFputc = $code -match '\bint\s+fputc\s*\('
    $linkOpt = @('-Wl,--gc-sections', ('-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/' + $name + '.map'), '-T${CMAKE_CURRENT_SOURCE_DIR}/cmake/Project.ld')
    if ($code -match '%[-+ #0]*\d*(\.\d+)?l?[fFeEgG]') {
        $linkOpt += '-u _printf_float'
        if ($code -match '\bscanf\s*\(') { $linkOpt += '-u _scanf_float' }
    }

    $cmakeDir = Join-Path $dir 'cmake'
    New-Item -ItemType Directory -Force $cmakeDir | Out-Null
    Remove-Stale (Join-Path $cmakeDir 'armcc-toolchain.cmake')
    Remove-Stale (Join-Path $cmakeDir 'Project.sct')
    Remove-StaleBuilds $dir
    Remove-KeilFiles $dir

    # Startup file
    $startup = Convert-Startup $startupPath
    Save-Text (Join-Path $cmakeDir 'startup_gcc.s') $startup.Text.Replace('{MARKER}', $Marker).Replace('{CPU}', $cpu)
    $srcList = @('cmake/startup_gcc.s')

    # core_cm3.c: its STREX inline assembly lets GCC use the same register twice, which the assembler rejects
    foreach ($c in $cSrc) {
        if ((Split-Path $c -Leaf) -ieq 'core_cm3.c') {
            $coreText = [IO.File]::ReadAllText((Join-Path $dir $c), $Latin1)
            $coreText = [regex]::Replace($coreText, '(strex[bh]?\s+%0[^\n]*?)"=r"', '$1"=&r"')
            [IO.File]::WriteAllText((Join-Path $cmakeDir 'core_cm3_gcc.c'), "/* $Marker from $c */`n" + $coreText, $Latin1)
            $srcList += 'cmake/core_cm3_gcc.c'
        } else {
            $srcList += $c
        }
    }

    # printf: Keil's MicroLIB calls fputc, GCC's newlib calls _write and buffers stdout
    $compatFile = Join-Path $cmakeDir 'keil_compat.c'
    if ($hasFputc) {
        $compat = @'
/* {MARKER}. Routes printf to the project's own fputc, as Keil's MicroLIB does. */
#include <stdio.h>

int _write(int fd, char *buf, int len)
{
    int i;
    (void)fd;
    for (i = 0; i < len; i++) {
        fputc((unsigned char)buf[i], stdout);
    }
    return len;
}

__attribute__((constructor)) static void keil_compat_stdio_init(void)
{
    setvbuf(stdout, NULL, _IONBF, 0);
}
'@
        Save-Text $compatFile $compat.Replace('{MARKER}', $Marker)
        $srcList += 'cmake/keil_compat.c'
    } else {
        Remove-Stale $compatFile
    }

    # Linker script
    $ld = @'
/* {MARKER}. Memory layout from the Keil project's Target page; stack and heap sizes from its startup file. */
ENTRY(Reset_Handler)

_estack = ORIGIN(RAM) + LENGTH(RAM);
_Min_Stack_Size = {STACK};
_Min_Heap_Size = {HEAP};

MEMORY
{
    FLASH (rx)  : ORIGIN = {ROMBASE}, LENGTH = {ROMSIZE}
    RAM   (xrw) : ORIGIN = {RAMBASE}, LENGTH = {RAMSIZE}
}

SECTIONS
{
    .isr_vector :
    {
        . = ALIGN(4);
        KEEP(*(.isr_vector))
        . = ALIGN(4);
    } >FLASH

    .text :
    {
        . = ALIGN(4);
        *(.text)
        *(.text*)
        *(.glue_7)
        *(.glue_7t)
        *(.eh_frame)
        KEEP(*(.init))
        KEEP(*(.fini))
        . = ALIGN(4);
        _etext = .;
    } >FLASH

    .rodata :
    {
        . = ALIGN(4);
        *(.rodata)
        *(.rodata*)
        . = ALIGN(4);
    } >FLASH

    .ARM.extab : { *(.ARM.extab* .gnu.linkonce.armextab.*) } >FLASH
    .ARM :
    {
        __exidx_start = .;
        *(.ARM.exidx*)
        __exidx_end = .;
    } >FLASH

    .preinit_array :
    {
        PROVIDE_HIDDEN(__preinit_array_start = .);
        KEEP(*(.preinit_array*))
        PROVIDE_HIDDEN(__preinit_array_end = .);
    } >FLASH
    .init_array :
    {
        PROVIDE_HIDDEN(__init_array_start = .);
        KEEP(*(SORT(.init_array.*)))
        KEEP(*(.init_array*))
        PROVIDE_HIDDEN(__init_array_end = .);
    } >FLASH
    .fini_array :
    {
        PROVIDE_HIDDEN(__fini_array_start = .);
        KEEP(*(SORT(.fini_array.*)))
        KEEP(*(.fini_array*))
        PROVIDE_HIDDEN(__fini_array_end = .);
    } >FLASH

    _sidata = LOADADDR(.data);

    .data :
    {
        . = ALIGN(4);
        _sdata = .;
        *(.data)
        *(.data*)
        . = ALIGN(4);
        _edata = .;
    } >RAM AT> FLASH

    .bss :
    {
        . = ALIGN(4);
        _sbss = .;
        __bss_start__ = _sbss;
        *(.bss)
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = .;
        __bss_end__ = _ebss;
    } >RAM

    ._user_heap_stack (NOLOAD) :
    {
        . = ALIGN(8);
        PROVIDE(end = .);
        PROVIDE(_end = .);
        . = . + _Min_Heap_Size;
        . = . + _Min_Stack_Size;
        . = ALIGN(8);
    } >RAM

    .ARM.attributes 0 : { *(.ARM.attributes) }
}
'@
    Save-Text (Join-Path $cmakeDir 'Project.ld') $ld.Replace('{MARKER}', $Marker).Replace('{ROMBASE}', $romBase).Replace('{ROMSIZE}', $romSize).Replace('{RAMBASE}', $ramBase).Replace('{RAMSIZE}', $ramSize).Replace('{STACK}', $startup.Stack).Replace('{HEAP}', $startup.Heap)

    # Toolchain: no absolute paths from this machine, so the folder also builds on macOS and Linux
    $toolchain = @'
# {MARKER}. Do not edit by hand.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# IDEs started from the desktop often lack the shell's PATH, so look in the usual install folders too
file(GLOB ARM_GCC_HINTS
    "$ENV{ARM_GCC_ROOT}/bin"
    "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/*/bin"
    "C:/Program Files/Arm GNU Toolchain arm-none-eabi/*/bin"
    "/Applications/ArmGNUToolchain/*/arm-none-eabi/bin"
    "/opt/homebrew/bin"
    "/usr/local/bin"
)
find_program(ARM_GCC arm-none-eabi-gcc HINTS ${ARM_GCC_HINTS})
if(NOT ARM_GCC)
    message(FATAL_ERROR "arm-none-eabi-gcc not found. Install the Arm GNU Toolchain or set the ARM_GCC_ROOT environment variable.")
endif()
get_filename_component(ARM_GCC_BIN "${ARM_GCC}" DIRECTORY)

set(CMAKE_C_COMPILER "${ARM_GCC}")
set(CMAKE_ASM_COMPILER "${ARM_GCC}")
find_program(ARM_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_GCC_BIN}")
find_program(ARM_SIZE arm-none-eabi-size HINTS "${ARM_GCC_BIN}")

set(CMAKE_C_FLAGS_INIT "{ARCH}")
set(CMAKE_ASM_FLAGS_INIT "{ARCH}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "{ARCH} --specs=nano.specs --specs=nosys.specs")
'@
    Save-Text (Join-Path $cmakeDir 'arm-none-eabi-toolchain.cmake') $toolchain.Replace('{MARKER}', $Marker).Replace('{ARCH}', $archFlags)

    function Fmt($items) {
        return ($items | ForEach-Object {
            if ($_ -match '^-u ') { '    "SHELL:' + $_ + '"' } elseif ($_ -match '\s') { '    "' + $_ + '"' } else { "    $_" }
        }) -join "`n"
    }
    function FmtC($items) {
        return ($items | ForEach-Object {
            if ($_ -match '\s') { "    `"`$<`$<COMPILE_LANGUAGE:C>:$_>`"" } else { "    `$<`$<COMPILE_LANGUAGE:C>:$_>" }
        }) -join "`n"
    }

    $cmakeText = @'
# {MARKER} from {UVPROJX}. Re-run it after adding files in Keil; do not edit by hand.
cmake_minimum_required(VERSION 3.20)

if(NOT CMAKE_TOOLCHAIN_FILE)
    set(CMAKE_TOOLCHAIN_FILE "${CMAKE_CURRENT_SOURCE_DIR}/cmake/arm-none-eabi-toolchain.cmake")
endif()

project({TARGET} LANGUAGES C ASM)

# Build settings come from the Keil project, whichever CLion profile is selected
foreach(cfg DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set(CMAKE_C_FLAGS_${cfg} "")
    set(CMAKE_ASM_FLAGS_${cfg} "")
    set(CMAKE_EXE_LINKER_FLAGS_${cfg} "")
endforeach()

add_executable({TARGET}
{SRC}
)
set_target_properties({TARGET} PROPERTIES OUTPUT_NAME "{NAME}" SUFFIX ".elf")

target_include_directories({TARGET} PRIVATE
{INCS}
)
target_compile_definitions({TARGET} PRIVATE
{DEFS}
)
target_compile_options({TARGET} PRIVATE
{COPT}
)
target_link_options({TARGET} PRIVATE
{LOPT}
)
set_target_properties({TARGET} PROPERTIES LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/cmake/Project.ld")

add_custom_command(TARGET {TARGET} POST_BUILD
    COMMAND "${ARM_OBJCOPY}" -O ihex "$<TARGET_FILE_NAME:{TARGET}>" "{NAME}.hex"
    COMMAND "${ARM_SIZE}" "$<TARGET_FILE_NAME:{TARGET}>"
    COMMENT "Creating {NAME}.hex"
)
'@
    $cmakeText = $cmakeText.Replace('{MARKER}', $Marker).Replace('{UVPROJX}', $uv[0].Name).Replace('{TARGET}', $target).Replace('{NAME}', $name)
    $cmakeText = $cmakeText.Replace('{SRC}', (Fmt $srcList)).Replace('{INCS}', (FmtC $incs)).Replace('{DEFS}', (FmtC $defs)).Replace('{COPT}', (FmtC $cOpt)).Replace('{LOPT}', (Fmt $linkOpt))
    Save-Text $outFile $cmakeText

    Write-Host "  完成: $($cSrc.Count) 个 C 文件, CPU $cpu, 宏 $($defs -join ' ')"
}

try {
    $root = if ($env:K2C_ARG) { $env:K2C_ARG } else { (Get-Location).Path }
    if (-not (Test-Path -LiteralPath $root -PathType Container)) { throw "不是文件夹: $root" }
    if (Get-ChildItem -LiteralPath $root -Filter *.uvprojx) {
        $projects = @((Resolve-Path -LiteralPath $root).Path)
    } else {
        $projects = @(Get-ChildItem -LiteralPath $root -Directory | Where-Object {
            Get-ChildItem -LiteralPath $_.FullName -Filter *.uvprojx
        } | ForEach-Object { $_.FullName })
    }
    if (-not $projects) { throw "$root 及其子文件夹里没有 .uvprojx 工程。" }

    $failed = 0
    foreach ($p in $projects) {
        Write-Host "`n$p"
        try { Convert-Project $p }
        catch { Write-Host "  失败: $($_.Exception.Message)" -ForegroundColor Red; $failed++ }
    }
    if ($failed) { exit 1 }
    Write-Host "`n用 CLion 打开工程文件夹即可编译，输出在 cmake-build-debug 里。"
    exit 0
} catch {
    Write-Host "失败: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}
