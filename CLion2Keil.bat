@echo off
rem CLion2Keil: sync the file list, defines and include paths from a Keil2CLion project back to Keil, then delete the CLion files.
rem Usage: drag a project folder onto this file, or double-click a copy of it inside the project folder.
chcp 65001 >nul
setlocal
set "K2C_BAT=%~f0"
set "K2C_ARG=%~1"
powershell -NoProfile -Command "$s=[IO.File]::ReadAllText($env:K2C_BAT,[Text.Encoding]::UTF8); Invoke-Expression $s.Substring($s.IndexOf('#'+'__PS__'))"
set "K2C_RC=%errorlevel%"
if not defined K2C_NOPAUSE pause
exit /b %K2C_RC%

#__PS__
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
$Marker = 'Generated by Keil2CLion'
$Latin1 = [Text.Encoding]::GetEncoding(28591)

# Project files are edited as raw bytes (Latin-1 maps them 1:1), so everything not changed stays byte-identical
function Read-Raw($path) { return [IO.File]::ReadAllText($path, $Latin1) }
function Write-Raw($path, $text) { [IO.File]::WriteAllText($path, $text, $Latin1) }

function Get-Tag($text, $tag) {
    $m = [regex]::Match($text, "(?s)<$tag>(.*?)</$tag>")
    if ($m.Success) { return $m.Groups[1].Value.Trim() }
    return ''
}

# Top-level <Target> blocks; older projects also nest a <Target> element in the debug options
function Get-Targets($text) {
    $depth = 0
    $start = 0
    foreach ($m in [regex]::Matches($text, '</?Target>')) {
        if ($m.Value -eq '<Target>') {
            if ($depth -eq 0) { $start = $m.Index }
            $depth++
        } else {
            $depth--
            if ($depth -eq 0) {
                $length = $m.Index + $m.Length - $start
                [pscustomobject]@{ Index = $start; Length = $length; Value = $text.Substring($start, $length) }
            }
        }
    }
}

function Get-Key($path) {
    $p = ($path -replace '\\', '/') -replace '^(\./)+', ''
    $p = $p.TrimEnd('/')
    if (-not $p) { $p = '.' }
    return $p.ToLowerInvariant()
}

function Get-KeilPath($rel) {
    $p = $rel -replace '/', '\'
    if ($p -eq '.') { return '.\' }
    if ($p.StartsWith('..')) { return $p }
    return ".\$p"
}

# Arguments of every call of a CMake command, with generator expressions and quotes removed
function Get-CMakeArgs($text, $command) {
    $result = @()
    foreach ($m in [regex]::Matches($text, "(?is)\b$command\s*\(([\s\S]*?)\)\s*(?:\r?\n|$)")) {
        $tokens = @([regex]::Matches($m.Groups[1].Value, '"(?:[^"\\]|\\.)*"|[^\s"]+') | ForEach-Object { $_.Value })
        foreach ($tok in ($tokens | Select-Object -Skip 1)) {
            if ($tok.StartsWith('"')) { $tok = $tok.Substring(1, $tok.Length - 2) -replace '\\"', '"' }
            if ($tok -match '^(PRIVATE|PUBLIC|INTERFACE)$') { continue }
            $tok = $tok -replace '^SHELL:', ''
            if ($tok -match '^\$<\$<COMPILE_LANGUAGE:\w+>:(.*)>$') { $tok = $Matches[1] }
            $result += $tok
        }
    }
    return $result
}

function Get-CMakePath($tok) {
    $p = $tok -replace '^\$\{(CMAKE_CURRENT_SOURCE_DIR|CMAKE_SOURCE_DIR|PROJECT_SOURCE_DIR)\}/?', ''
    if ($p -match '\$\{') { throw "CMakeLists.txt 里的路径用了变量，无法同步: $tok" }
    if (-not $p) { return '.' }
    return $p
}

function Get-FileType($rel) {
    switch -regex ($rel) {
        '\.c$' { return '1' }
        '\.(s|asm)$' { return '2' }
        '\.h$' { return '5' }
    }
    return ''
}

function ConvertTo-Xml($text, $encoding) {
    $escaped = $text.Replace('&', '&amp;').Replace('<', '&lt;').Replace('>', '&gt;')
    return $Latin1.GetString($encoding.GetBytes($escaped))
}

function ConvertFrom-Xml($raw, $encoding) {
    $text = $encoding.GetString($Latin1.GetBytes($raw))
    return $text.Replace('&lt;', '<').Replace('&gt;', '>').Replace('&quot;', '"').Replace('&apos;', "'").Replace('&amp;', '&')
}

function Sync-Project($dir, $cmakeText) {
    $uv = @(Get-ChildItem -LiteralPath $dir -Filter *.uvprojx | Sort-Object Name)
    if ($uv.Count -ne 1) { throw "文件夹里应当正好有 1 个 .uvprojx，实际 $($uv.Count) 个。" }
    $uvPath = $uv[0].FullName
    $optPath = [IO.Path]::ChangeExtension($uvPath, '.uvoptx')

    $prj = Read-Raw $uvPath
    $encoding = [Text.Encoding]::UTF8
    if ($prj -match '^.*?encoding="([^"]+)"') { $encoding = [Text.Encoding]::GetEncoding($Matches[1]) }
    $nl = if ($prj.Contains("`r`n")) { "`r`n" } else { "`n" }

    $targets = @(Get-Targets $prj)
    if (-not $targets) { throw '工程里没有 Target。' }
    if ($targets.Count -gt 1) { Write-Host '  注意: 有多个 Target，只同步第一个' }
    $targetMatch = $targets[0]
    $target = $targetMatch.Value

    # What Keil lists now
    $keilFiles = @{}
    foreach ($g in [regex]::Matches($target, '(?s)<Group>.*?</Group>')) {
        $groupName = Get-Tag $g.Value 'GroupName'
        foreach ($f in [regex]::Matches($g.Value, '(?s)<File>.*?</File>')) {
            $path = ConvertFrom-Xml (Get-Tag $f.Value 'FilePath') $encoding
            $keilFiles[(Get-Key $path)] = @{ Path = $path; Type = (Get-Tag $f.Value 'FileType'); Group = $groupName }
        }
    }

    # What CMake lists now; files under cmake/ are generated stand-ins for Keil's startup and core_cm3 files
    $cmakeSources = @(Get-CMakeArgs $cmakeText 'add_executable' | ForEach-Object { Get-CMakePath $_ })
    if (-not $cmakeSources) { throw 'CMakeLists.txt 里找不到 add_executable。' }
    $cmakeKeys = @{}
    $usesCore = $false
    foreach ($s in $cmakeSources) {
        if ((Get-Key $s) -match '^cmake/core_cm\d+_gcc\.c$') { $usesCore = $true }
        if ((Get-Key $s) -notmatch '^cmake/') { $cmakeKeys[(Get-Key $s)] = $s }
    }

    $toAdd = @()
    foreach ($s in $cmakeSources) {
        $key = Get-Key $s
        if ($key -match '^cmake/' -or $keilFiles.ContainsKey($key)) { continue }
        $type = Get-FileType $key
        if ($type -eq '') { Write-Host "  未同步: 不认识的文件类型 $s"; continue }
        if ($type -eq '2') { Write-Host "  未同步: $s 是 GCC 汇编，Keil 编译不了，需要自己改写成 ARM 汇编后在 Keil 里添加"; continue }
        if (-not (Test-Path -LiteralPath (Join-Path $dir $s))) { throw "CMakeLists.txt 里列出的文件不存在: $s" }
        if ($toAdd -notcontains $s) { $toAdd += $s }
        # Keil lists headers next to their source file
        if ($type -eq '1') {
            $header = [IO.Path]::ChangeExtension($s, '.h')
            if ((Test-Path -LiteralPath (Join-Path $dir $header)) -and -not $keilFiles.ContainsKey((Get-Key $header)) -and -not $cmakeKeys.ContainsKey((Get-Key $header))) {
                $toAdd += $header
            }
        }
    }

    $toRemove = @{}
    foreach ($key in $keilFiles.Keys) {
        $info = $keilFiles[$key]
        if ($info.Type -eq '2') { continue }
        if ($usesCore -and $key -match '(^|/)core_cm\d+\.c$') { continue }
        $gone = -not (Test-Path -LiteralPath (Join-Path $dir ($info.Path -replace '\\', '/')))
        if ($gone -or ($info.Type -eq '1' -and -not $cmakeKeys.ContainsKey($key))) { $toRemove[$key] = $true }
    }

    # Which Keil group a new file belongs to: the one already holding files from its folder, else one named after the folder
    $groupOf = @{}
    foreach ($s in $toAdd) {
        $folder = (Split-Path $s -Parent) -replace '\\', '/'
        $best = $null
        foreach ($key in $keilFiles.Keys) {
            if ($toRemove.ContainsKey($key)) { continue }
            if ((Get-Key (Split-Path $keilFiles[$key].Path -Parent)) -eq (Get-Key $folder)) { $best = $keilFiles[$key].Group; break }
        }
        if (-not $best) {
            $parts = @($folder -split '/' | Where-Object { $_ -and $_ -ne '.' -and $_ -ne '..' })
            $best = if ($parts) { $parts[-1] } else { 'Source' }
        }
        $groupOf[$s] = $best
    }

    # Defines and include paths
    $cads = [regex]::Match($target, '(?s)<Cads>.*?</Cads>').Value
    $keilDefines = @(((Get-Tag $cads 'Define') -split '[;,]') | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    # The device macro comes from Keil's device pack, so it never goes in the Define box (older CMakeLists.txt list it directly)
    $cmakeDefines = @(Get-CMakeArgs $cmakeText 'target_compile_definitions' | Where-Object { $_ -ne '${KEIL_DEVICE_DEFINE}' -and $_ -notmatch '^STM32F10X_(LD|LD_VL|MD|MD_VL|HD|HD_VL|XL|CL)$' })
    $newDefines = @($keilDefines | Where-Object { $cmakeDefines -contains $_ })
    $newDefines += @($cmakeDefines | Where-Object { $keilDefines -notcontains $_ } | Select-Object -Unique)
    $definesChanged = (@($newDefines) -join ',') -ne (@($keilDefines) -join ',')

    $keilIncs = @(((Get-Tag $cads 'IncludePath') -split ';') | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    $cmakeIncs = @(Get-CMakeArgs $cmakeText 'target_include_directories' | ForEach-Object { Get-CMakePath $_ })
    foreach ($s in $toAdd) {
        $folder = (Split-Path $s -Parent) -replace '\\', '/'
        if (-not $folder) { $folder = '.' }
        if (Get-ChildItem -LiteralPath (Join-Path $dir $folder) -Filter *.h -ErrorAction SilentlyContinue) {
            if (@($cmakeIncs | Where-Object { (Get-Key $_) -eq (Get-Key $folder) }).Count -eq 0) { $cmakeIncs += $folder }
        }
    }
    $cmakeIncKeys = @($cmakeIncs | ForEach-Object { Get-Key $_ })
    $keilIncKeys = @($keilIncs | ForEach-Object { Get-Key $_ })
    $newIncs = @($keilIncs | Where-Object { $cmakeIncKeys -contains (Get-Key $_) })
    $newIncs += @($cmakeIncs | Where-Object { $keilIncKeys -notcontains (Get-Key $_) } | ForEach-Object { Get-KeilPath $_ } | Select-Object -Unique)
    $incsChanged = (@($newIncs) -join ';') -ne (@($keilIncs) -join ';')

    if ($toAdd.Count -or $toRemove.Count -or $definesChanged -or $incsChanged) {
        # .uvprojx
        $newTarget = $target
        if ($toRemove.Count) {
            $newTarget = [regex]::Replace($newTarget, '(?s)[ \t]*<File>.*?</File>\r?\n', [Text.RegularExpressions.MatchEvaluator]{
                param($m)
                if ($toRemove.ContainsKey((Get-Key (ConvertFrom-Xml (Get-Tag $m.Value 'FilePath') $encoding)))) { return '' }
                return $m.Value
            })
        }
        foreach ($s in $toAdd) {
            $keilPath = ConvertTo-Xml (Get-KeilPath $s) $encoding
            $fileName = ConvertTo-Xml (Split-Path $s -Leaf) $encoding
            $groupName = ConvertTo-Xml $groupOf[$s] $encoding
            $entry = @("            <File>", "              <FileName>$fileName</FileName>", "              <FileType>$(Get-FileType (Get-Key $s))</FileType>", "              <FilePath>$keilPath</FilePath>", "            </File>") -join $nl
            $groupMatch = $null
            foreach ($g in [regex]::Matches($newTarget, '(?s)<Group>.*?</Group>')) {
                if ((Get-Tag $g.Value 'GroupName') -eq $groupName) { $groupMatch = $g; break }
            }
            if ($groupMatch -and $groupMatch.Value.Contains('</Files>')) {
                $at = $groupMatch.Index + $groupMatch.Value.LastIndexOf('</Files>')
                $lineStart = $newTarget.LastIndexOf("`n", $at) + 1
                $newTarget = $newTarget.Insert($lineStart, $entry + $nl)
            } elseif ($groupMatch) {
                $at = $groupMatch.Index + $groupMatch.Value.LastIndexOf('</Group>')
                $lineStart = $newTarget.LastIndexOf("`n", $at) + 1
                $newTarget = $newTarget.Insert($lineStart, "          <Files>$nl$entry$nl          </Files>$nl")
            } else {
                $block = @("        <Group>", "          <GroupName>$groupName</GroupName>", "          <Files>", $entry, "          </Files>", "        </Group>") -join $nl
                $at = $newTarget.LastIndexOf('</Groups>')
                $lineStart = $newTarget.LastIndexOf("`n", $at) + 1
                $newTarget = $newTarget.Insert($lineStart, $block + $nl)
            }
        }
        # Groups this run emptied go too, as they would after removing the files in Keil's own dialog
        if ($toRemove.Count) {
            $hadFiles = @{}
            foreach ($g in [regex]::Matches($target, '(?s)<Group>.*?</Group>')) { if ($g.Value -match '<File>') { $hadFiles[(Get-Tag $g.Value 'GroupName')] = $true } }
            $newTarget = [regex]::Replace($newTarget, '(?s)[ \t]*<Group>.*?</Group>\r?\n', [Text.RegularExpressions.MatchEvaluator]{
                param($m)
                if ($m.Value -notmatch '<File>' -and $hadFiles.ContainsKey((Get-Tag $m.Value 'GroupName'))) { return '' }
                return $m.Value
            })
        }
        if ($definesChanged -or $incsChanged) {
            $oldCads = [regex]::Match($newTarget, '(?s)<Cads>.*?</Cads>')
            $newCads = $oldCads.Value
            if ($definesChanged) { $newCads = ([regex]'(?s)<Define>.*?</Define>').Replace($newCads, '<Define>' + (ConvertTo-Xml ($newDefines -join ',') $encoding) + '</Define>', 1) }
            if ($incsChanged) { $newCads = ([regex]'(?s)<IncludePath>.*?</IncludePath>').Replace($newCads, '<IncludePath>' + (ConvertTo-Xml ($newIncs -join ';') $encoding) + '</IncludePath>', 1) }
            $newTarget = $newTarget.Remove($oldCads.Index, $oldCads.Length).Insert($oldCads.Index, $newCads)
        }
        $newPrj = $prj.Remove($targetMatch.Index, $targetMatch.Length).Insert($targetMatch.Index, $newTarget)

        # .uvoptx mirrors the file tree
        $newOpt = $null
        if (Test-Path -LiteralPath $optPath) {
            $opt = Read-Raw $optPath
            $optNl = if ($opt.Contains("`r`n")) { "`r`n" } else { "`n" }
            $newOpt = $opt
            if ($toRemove.Count) {
                $newOpt = [regex]::Replace($newOpt, '(?s)[ \t]*<File>.*?</File>\r?\n', [Text.RegularExpressions.MatchEvaluator]{
                    param($m)
                    if ($toRemove.ContainsKey((Get-Key (ConvertFrom-Xml (Get-Tag $m.Value 'PathWithFileName') $encoding)))) { return '' }
                    return $m.Value
                })
            }
            foreach ($s in $toAdd) {
                $keilPath = ConvertTo-Xml (Get-KeilPath $s) $encoding
                $fileName = ConvertTo-Xml (Split-Path $s -Leaf) $encoding
                $groupName = ConvertTo-Xml $groupOf[$s] $encoding
                $entry = @("    <File>", "      <GroupNumber>0</GroupNumber>", "      <FileNumber>0</FileNumber>", "      <FileType>$(Get-FileType (Get-Key $s))</FileType>", "      <tvExp>0</tvExp>", "      <tvExpOptDlg>0</tvExpOptDlg>", "      <bDave2>0</bDave2>", "      <PathWithFileName>$keilPath</PathWithFileName>", "      <FilenameWithoutPath>$fileName</FilenameWithoutPath>", "      <RteFlg>0</RteFlg>", "      <bShared>0</bShared>", "    </File>") -join $optNl
                $groupMatch = $null
                foreach ($g in [regex]::Matches($newOpt, '(?s)<Group>.*?</Group>')) {
                    if ((Get-Tag $g.Value 'GroupName') -eq $groupName) { $groupMatch = $g; break }
                }
                if ($groupMatch) {
                    $at = $groupMatch.Index + $groupMatch.Value.LastIndexOf('</Group>')
                    $lineStart = $newOpt.LastIndexOf("`n", $at) + 1
                    $newOpt = $newOpt.Insert($lineStart, $entry + $optNl)
                } else {
                    $block = @("  <Group>", "    <GroupName>$groupName</GroupName>", "    <tvExp>0</tvExp>", "    <tvExpOptDlg>0</tvExpOptDlg>", "    <cbSel>0</cbSel>", "    <RteFlg>0</RteFlg>", $entry, "  </Group>", "", "") -join $optNl
                    $newOpt = $newOpt.Insert($newOpt.LastIndexOf('</ProjectOpt>'), $block)
                }
            }
            if ($toRemove.Count) {
                $hadFiles = @{}
                foreach ($g in [regex]::Matches($opt, '(?s)<Group>.*?</Group>')) { if ($g.Value -match '<File>') { $hadFiles[(Get-Tag $g.Value 'GroupName')] = $true } }
                $newOpt = [regex]::Replace($newOpt, '(?s)[ \t]*<Group>(?:(?!</Group>).)*?</Group>\r?\n\r?\n', [Text.RegularExpressions.MatchEvaluator]{
                    param($m)
                    if ($m.Value -notmatch '<File>' -and $hadFiles.ContainsKey((Get-Tag $m.Value 'GroupName'))) { return '' }
                    return $m.Value
                })
            }
            # Keil numbers groups and files sequentially
            $count = @{ Group = 0; File = 0 }
            $newOpt = [regex]::Replace($newOpt, '(?s)<Group>.*?</Group>', [Text.RegularExpressions.MatchEvaluator]{
                param($g)
                $count.Group++
                $number = $count.Group
                return [regex]::Replace($g.Value, '(?s)<File>.*?</File>', [Text.RegularExpressions.MatchEvaluator]{
                    param($f)
                    $count.File++
                    $text = [regex]::Replace($f.Value, '<GroupNumber>\d+</GroupNumber>', "<GroupNumber>$number</GroupNumber>")
                    return [regex]::Replace($text, '<FileNumber>\d+</FileNumber>', "<FileNumber>$($count.File)</FileNumber>")
                })
            })
        }

        Copy-Item -LiteralPath $uvPath -Destination "$uvPath.bak" -Force
        Write-Raw $uvPath $newPrj
        if ($null -ne $newOpt -and $newOpt -cne $opt) {
            Copy-Item -LiteralPath $optPath -Destination "$optPath.bak" -Force
            Write-Raw $optPath $newOpt
        }

        foreach ($s in $toAdd) { Write-Host "  新增: $s（分组 $($groupOf[$s])）" }
        foreach ($key in $toRemove.Keys) { Write-Host "  移除: $($keilFiles[$key].Path)（只从 Keil 工程移除，文件本身不删）" }
        if ($definesChanged) { Write-Host "  宏定义: $($newDefines -join ',')" }
        if ($incsChanged) { Write-Host "  头文件路径: $($newIncs -join ';')" }
        Write-Host "  原工程文件已备份为 .bak"
    } else {
        Write-Host '  文件列表、宏定义、头文件路径和 Keil 一致，工程文件未改动'
    }

    # Things Keil has no setting for, or that only the author can decide
    $known = '^(-g|-ffunction-sections|-fdata-sections|-O[0-3sgz]?|-std=\S+|-fshort-enums|-fsigned-char|-funsigned-char|-w|-Wall)$'
    foreach ($o in (Get-CMakeArgs $cmakeText 'target_compile_options' | Where-Object { $_ -notmatch $known })) { Write-Host "  未同步: 编译选项 $o" }
    foreach ($o in (Get-CMakeArgs $cmakeText 'target_link_options' | Where-Object { $_ -notmatch '^(-Wl,--gc-sections|-Wl,-Map=.*|-T.*|-u _(printf|scanf)_float)$' })) { Write-Host "  未同步: 链接选项 $o" }
    foreach ($o in (Get-CMakeArgs $cmakeText 'target_link_libraries')) { Write-Host "  未同步: 链接库 $o" }
    $levels = @{ '1' = '-O0'; '2' = '-O1'; '3' = '-O2'; '4' = '-O3' }
    $keilLevel = $levels[(Get-Tag $cads 'Optim')]
    $cmakeLevel = @(Get-CMakeArgs $cmakeText 'target_compile_options' | Where-Object { $_ -match '^-O' }) | Select-Object -Last 1
    if ($keilLevel -and $cmakeLevel -and $keilLevel -ne $cmakeLevel) { Write-Host "  未同步: 优化等级，CLion 是 $cmakeLevel，Keil 是 $keilLevel，需要的话在 Keil 里改" }

    # Code that compiled with GCC but ARMCC rejects
    $patterns = @(
        @{ Regex = '\b0[bB][01]+\b'; Text = '二进制字面量' },
        @{ Regex = '\b(__)?typeof(__)?\s*\('; Text = 'typeof' },
        @{ Regex = '\(\s*\{'; Text = '语句表达式' },
        @{ Regex = '\b_write\s*\('; Text = '_write（Keil 的 printf 要用 fputc）' }
    )
    $warned = 0
    foreach ($f in Get-ChildItem -LiteralPath $dir -Recurse -File | Where-Object { $_.Extension -in '.c', '.h' }) {
        $rel = $f.FullName.Substring($dir.Length).TrimStart('\')
        if ($rel -match '^(cmake|Library|Start|Objects|Listings|DebugConfig|cmake-build-[^\\]*|\.idea)\\') { continue }
        if ($rel -match '[^\x00-\x7F]') { Write-Host "  Keil 可能报错: $rel 的名字含非英文字符，ARMCC 打不开这样的文件，建议改成英文名"; $warned++ }
        $n = 0
        foreach ($line in [IO.File]::ReadAllLines($f.FullName)) {
            $n++
            $code = $line -replace '//.*$', ''
            foreach ($p in $patterns) {
                if ($code -match $p.Regex) { Write-Host "  Keil 可能报错: ${rel}:$n $($p.Text)"; $warned++ }
            }
        }
    }
    if ($warned) { Write-Host "  以上写法 ARMCC 不支持或不适用，建议改掉后再用 Keil 编译" }
}

function Remove-CLionFiles($dir) {
    foreach ($b in Get-ChildItem -LiteralPath $dir -Directory -Filter 'cmake-build-*') { Remove-Item -LiteralPath $b.FullName -Recurse -Force }
    $idea = Join-Path $dir '.idea'
    if (Test-Path -LiteralPath $idea) { Remove-Item -LiteralPath $idea -Recurse -Force }
    $cmakeDir = Join-Path $dir 'cmake'
    if (Test-Path -LiteralPath $cmakeDir) {
        foreach ($f in Get-ChildItem -LiteralPath $cmakeDir -File) {
            if ((Read-Raw $f.FullName).Contains($Marker)) { Remove-Item -LiteralPath $f.FullName -Force }
        }
        $left = @(Get-ChildItem -LiteralPath $cmakeDir -Force)
        if ($left) { Write-Host "  保留: cmake 文件夹里有不是脚本生成的文件: $(($left | ForEach-Object { $_.Name }) -join ', ')" }
        else { Remove-Item -LiteralPath $cmakeDir -Force }
    }
    Remove-Item -LiteralPath (Join-Path $dir 'CMakeLists.txt') -Force
    Write-Host '  已删除 CLion 文件: cmake-build-*, .idea, cmake, CMakeLists.txt'
}

try {
    # Deleting files needs a project named on purpose, so unlike Keil2CLion this never walks into subfolders
    $root = if ($env:K2C_ARG) { $env:K2C_ARG } else { (Get-Location).Path }
    if (-not (Test-Path -LiteralPath $root -PathType Container)) { throw "不是文件夹: $root" }
    $dir = (Resolve-Path -LiteralPath $root).Path
    if (-not (Get-ChildItem -LiteralPath $dir -Filter *.uvprojx)) { throw "$dir 里没有 .uvprojx。请把工程文件夹拖到本文件上。" }

    $cmakeFile = Join-Path $dir 'CMakeLists.txt'
    if (-not (Test-Path -LiteralPath $cmakeFile)) { throw 'CMakeLists.txt 不存在，这个工程已经是 Keil 结构了。' }
    $cmakeText = [IO.File]::ReadAllText($cmakeFile)
    if (-not $cmakeText.Contains($Marker)) { throw 'CMakeLists.txt 不是 Keil2CLion 生成的，为避免误删，没有做任何改动。' }

    if (Get-Process UV4 -ErrorAction SilentlyContinue) { throw '请先关闭 Keil，否则它保存工程时可能覆盖同步结果。没有做任何改动。' }
    $folderName = Split-Path $dir -Leaf
    if (Get-Process clion64 -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -like "*$folderName*" }) {
        throw "请先在 CLion 里关闭 $folderName 工程。没有做任何改动。"
    }

    Write-Host $dir
    Sync-Project $dir $cmakeText
    Remove-CLionFiles $dir
    Write-Host "`n可以用 Keil 打开工程编译了。想回到 CLion，再运行一次 Keil2CLion.bat。"
    exit 0
} catch {
    Write-Host "失败: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}
